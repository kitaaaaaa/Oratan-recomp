+/**
+ * @file        system/split_screen.cpp
+ * @brief       Tags guest frame swaps for split-screen composition.
+ */
+
+#include <rex/system/split_screen.h>
+
+#include <atomic>
+#include <deque>
+#include <mutex>
+
+namespace rex::system::split_screen {
+namespace {
+
+std::atomic<int32_t> g_next_view{kNoView};
+std::atomic<int32_t> g_vblank_multiplier{1};
+std::atomic<int32_t> g_layout{int32_t(Layout::kSideBySide)};
+std::atomic<bool> g_mirror_untagged{false};
+
+std::mutex g_mutex;
+std::deque<int32_t> g_tags;
+
+// Swaps are processed a few frames behind the guest at most; anything beyond
+// this means tags stopped being consumed (e.g. no GPU backend), so drop the
+// oldest rather than grow without bound.
+constexpr size_t kMaxQueued = 16;
+
+}  // namespace
+
+void SetNextSwapView(int32_t view) { g_next_view.store(view, std::memory_order_relaxed); }
+
+void OnGuestSwap() {
+  const int32_t view = g_next_view.exchange(kNoView, std::memory_order_relaxed);
+  std::lock_guard lock(g_mutex);
+  if (g_tags.size() >= kMaxQueued) g_tags.pop_front();
+  g_tags.push_back(view);
+}
+
+int32_t PopSwapTag() {
+  std::lock_guard lock(g_mutex);
+  if (g_tags.empty()) return kNoView;
+  const int32_t view = g_tags.front();
+  g_tags.pop_front();
+  return view;
+}
+
+void SetVblankMultiplier(int32_t multiplier) {
+  g_vblank_multiplier.store(multiplier < 1 ? 1 : multiplier, std::memory_order_relaxed);
+}
+
+int32_t VblankMultiplier() { return g_vblank_multiplier.load(std::memory_order_relaxed); }
+
+void SetLayout(Layout layout) { g_layout.store(int32_t(layout), std::memory_order_relaxed); }
+
+Layout GetLayout() { return Layout(g_layout.load(std::memory_order_relaxed)); }
+
+void SetMirrorUntagged(bool mirror) { g_mirror_untagged.store(mirror, std::memory_order_relaxed); }
+
+bool MirrorUntagged() { return g_mirror_untagged.load(std::memory_order_relaxed); }
+
+}  // namespace rex::system::split_screen
