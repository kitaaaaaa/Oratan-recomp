+bool D3D12CommandProcessor::EnsureSplitScreenTextures(uint32_t width, uint32_t height,
+                                                      uint32_t canvas_width,
+                                                      uint32_t canvas_height) {
+  if (split_scratch_texture_) {
+    D3D12_RESOURCE_DESC existing = split_scratch_texture_->GetDesc();
+    D3D12_RESOURCE_DESC existing_canvas = split_composite_texture_->GetDesc();
+    if (existing.Width == width && existing.Height == height &&
+        existing_canvas.Width == canvas_width && existing_canvas.Height == canvas_height) {
+      return true;
+    }
+    for (auto* texture : {std::addressof(split_scratch_texture_), std::addressof(split_composite_texture_)}) {
+      if (submission_completed_ < split_textures_submission_) {
+        (*texture)->AddRef();
+        resources_for_deletion_.emplace_back(split_textures_submission_, texture->Get());
+      }
+      texture->Reset();
+    }
+    split_textures_submission_ = 0;
+  }
+  split_views_received_ = 0;
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  D3D12_RESOURCE_DESC desc = {};
+  desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  desc.Width = width;
+  desc.Height = height;
+  desc.DepthOrArraySize = 1;
+  desc.MipLevels = 1;
+  desc.Format = ui::d3d12::D3D12Presenter::kGuestOutputFormat;
+  desc.SampleDesc.Count = 1;
+  desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+  for (auto* texture : {std::addressof(split_scratch_texture_), std::addressof(split_composite_texture_)}) {
+    const bool is_canvas = texture == std::addressof(split_composite_texture_);
+    desc.Width = is_canvas ? canvas_width : width;
+    desc.Height = is_canvas ? canvas_height : height;
+    // The canvas is zero-initialized so slots no view is copied into (the
+    // staggered layout's other two quarters) stay black.
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault,
+            is_canvas ? D3D12_HEAP_FLAG_NONE : provider.GetHeapFlagCreateNotZeroed(), &desc,
+            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, nullptr,
+            IID_PPV_ARGS(texture->ReleaseAndGetAddressOf())))) {
+      REXGPU_ERROR("Failed to create the split screen textures");
+      split_scratch_texture_.Reset();
+      split_composite_texture_.Reset();
+      return false;
+    }
+  }
+  return true;
+}
