+/**
+ * @file        system/split_screen.h
+ * @brief       Tags guest frame swaps for split-screen composition.
+ *
+ * A title that renders one full frame per viewpoint (e.g. one per player)
+ * names the viewpoint of its next swap before issuing it. VdSwap queues that
+ * tag alongside the swap packet it writes, so tags and swaps stay one to one
+ * even when the title skips a swap. The GPU backend pops the tags in swap
+ * order and composes the tagged frames side by side into one presented image.
+ * Untagged swaps are presented normally.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::system::split_screen {
+
+// Number of viewpoints composed side by side.
+inline constexpr int32_t kViewCount = 2;
+
+// Tag for an untagged (normal, full-screen) swap.
+inline constexpr int32_t kNoView = -1;
+
+// Called by the title before it issues a swap: `view` is the viewpoint
+// (0 = left, 1 = right) the next swapped frame was rendered from, or kNoView.
+// Applies to the next VdSwap only; a later call before that swap replaces it.
+void SetNextSwapView(int32_t view);
+
+// Called by VdSwap for every swap packet it writes: queues the view set by
+// SetNextSwapView (kNoView if none) and clears it.
+void OnGuestSwap();
+
+// Called by the GPU backend once per processed swap, in order. Returns
+// kNoView when no tag is queued.
+int32_t PopSwapTag();
+
+// Guest vertical blanks per display refresh requested by the title while it
+// presents several frames per tick (1 = normal). Runtime state only, never
+// saved; the guest_vblank_multiplier cvar is the user's setting and the
+// higher of the two applies.
+void SetVblankMultiplier(int32_t multiplier);
+int32_t VblankMultiplier();
+
+// How the views are arranged in the presented image (runtime state, set by the
+// title from its own settings).
+enum class Layout : int32_t {
+  kSideBySide = 0,  // view 0 left, view 1 right
+  kStaggered = 1,   // view 0 top-left, view 1 bottom-right, other quarters black
+};
+void SetLayout(Layout layout);
+Layout GetLayout();
+
+// When set, untagged swaps are copied into every slot (side by side), so a
+// window spanning one monitor per slot shows the same full-screen image on each
+// (menus, loading screens) instead of one image across the bezel.
+void SetMirrorUntagged(bool mirror);
+bool MirrorUntagged();
+
+}  // namespace rex::system::split_screen
