+bool XSocket::Readable() const {
+  fd_set read_set;
+  FD_ZERO(&read_set);
+#if REX_PLATFORM_WIN32
+  FD_SET(SOCKET(native_handle_), &read_set);
+#else
+  FD_SET(int(native_handle_), &read_set);
+#endif
+  timeval zero{0, 0};
+  return select(int(native_handle_ + 1), &read_set, nullptr, nullptr, &zero) > 0;
+}
+
+void XSocket::LogPacket(const char* what, uint32_t address, uint16_t port, const uint8_t* data,
+                        int length) {
+  // Every packet of the first few hundred, then one in 600 (10 s of a 60 Hz
+  // stream).
+  static std::atomic<uint32_t> count{0};
+  const uint32_t n = count++;
+  if (n >= 400 && n % 600 != 0) {
+    return;
+  }
+  std::string bytes;
+  const int shown = length > 0 ? std::min(length, 48) : 0;
+  for (int i = 0; i < shown; ++i) {
+    static const char kHex[] = "0123456789ABCDEF";
+    bytes += kHex[data[i] >> 4];
+    bytes += kHex[data[i] & 15];
+  }
+  REXSYS_INFO("net: {} socket {:08X} (port {}) {} {}:{} {} byte(s) [{}]{}", what, handle(),
+              bound_port_, std::strcmp(what, "send") == 0 ? "to" : "from",
+              system_link::Dotted(address), port, length, bytes, length > shown ? "..." : "");
 }
 
