+/**
+ * @file        system/system_link.cpp
+ * @brief       --system_link: see rex/system/system_link.h.
+ *
+ * Address choice and per-console identity follow Xerenge's --online
+ * (github.com/shipa-2/rexglue-xerenge, xam_net.cpp).
+ */
+
+#include <rex/system/system_link.h>
+
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <random>
+#include <sstream>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WIN32
+#include <WinSock2.h>
+
+#include <WS2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+REXCVAR_DEFINE_BOOL(system_link, false, "Network",
+                    "Act as a console on the local network, so the title's System Link works "
+                    "with other copies on the LAN (or on this PC, see lan_address)");
+REXCVAR_DEFINE_STRING(lan_address, "", "Network",
+                      "System Link: the IPv4 this console uses. Empty: the PC's LAN address. "
+                      "127.0.0.2, 127.0.0.3, ... run several copies on one PC");
+REXCVAR_DEFINE_STRING(lan_peers, "", "Network",
+                      "System Link: addresses (comma-separated) that also get a copy of every "
+                      "broadcast, for networks that drop broadcasts (Wi-Fi, VPNs)");
+REXCVAR_DEFINE_STRING(player_name, "", "Network",
+                      "System Link: this console's gamertag (up to 15 characters). Empty: "
+                      "Player plus the address's last number");
+REXCVAR_DEFINE_BOOL(net_log, false, "Network", "Log the title's network calls");
+
+namespace rex::system::system_link {
+
+bool Enabled() {
+  return REXCVAR_GET(system_link);
+}
+
+bool Logging() {
+  return REXCVAR_GET(net_log);
+}
+
+std::string Dotted(uint32_t address) {
+  char text[INET_ADDRSTRLEN] = "?";
+  inet_ntop(AF_INET, &address, text, sizeof(text));
+  return text;
+}
+
+namespace {
+
+uint32_t Parse(const std::string& text) {
+  in_addr parsed{};
+  if (inet_pton(AF_INET, text.c_str(), &parsed) == 1) {
+    return uint32_t(parsed.s_addr);
+  }
+  return 0;
+}
+
+bool IsLoopback(uint32_t address) {
+  return (ntohl(address) >> 24) == 127;
+}
+
+// The interface a packet to the outside would leave by. A UDP "connect" only
+// picks the route; nothing is sent.
+uint32_t RouteAddress() {
+#if REX_PLATFORM_WIN32
+  WSADATA wsa;
+  WSAStartup(MAKEWORD(2, 2), &wsa);
+#endif
+  uint32_t found = htonl(INADDR_LOOPBACK);
+  const auto probe = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  sockaddr_in to{};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(9);
+  inet_pton(AF_INET, "192.0.2.1", &to.sin_addr);  // TEST-NET-1, never answered
+  if (::connect(probe, reinterpret_cast<sockaddr*>(&to), sizeof(to)) == 0) {
+    sockaddr_in self{};
+    socklen_t self_len = sizeof(self);
+    if (::getsockname(probe, reinterpret_cast<sockaddr*>(&self), &self_len) == 0 &&
+        self.sin_addr.s_addr != 0) {
+      found = self.sin_addr.s_addr;
+    }
+  }
+#if REX_PLATFORM_WIN32
+  closesocket(probe);
+#else
+  ::close(probe);
+#endif
+  return found;
+}
+
+uint64_t Fnv(const std::string& text) {
+  uint64_t h = 0xCBF29CE484222325ull;
+  for (const unsigned char c : text) {
+    h = (h ^ c) * 0x100000001B3ull;
+  }
+  return h;
+}
+
+std::mutex g_random_mutex;
+
+}  // namespace
+
+uint32_t LocalAddress() {
+  static const uint32_t address = [] {
+    const std::string configured = REXCVAR_GET(lan_address);
+    uint32_t chosen = 0;
+    if (!configured.empty()) {
+      chosen = Parse(configured);
+      if (!chosen) {
+        REXSYS_WARN("system link: lan_address '{}' is not an IPv4 address", configured);
+      }
+    }
+    if (!chosen) {
+      chosen = RouteAddress();
+    }
+    REXSYS_INFO("system link: this console's address is {}", Dotted(chosen));
+    return chosen;
+  }();
+  return address;
+}
+
+uint32_t BindAddress() {
+  return REXCVAR_GET(lan_address).empty() ? htonl(INADDR_ANY) : LocalAddress();
+}
+
+void FillIdentity(uint32_t address, uint8_t enet[6], uint8_t online[20]) {
+  const uint8_t* ip = reinterpret_cast<const uint8_t*>(&address);
+  enet[0] = 0x02;  // locally administered
+  enet[1] = 0x58;
+  for (int i = 0; i < 4; ++i) {
+    enet[2 + i] = ip[i];
+  }
+  for (uint8_t i = 0; i < 20; ++i) {
+    online[i] = uint8_t(0x5A + i) ^ ip[i % 4];
+  }
+}
+
+std::vector<uint32_t> BroadcastCopies() {
+  static const std::vector<uint32_t> copies = [] {
+    std::vector<uint32_t> list;
+    const uint32_t self = LocalAddress();
+    if (IsLoopback(self)) {
+      for (uint32_t last = 1; last <= 8; ++last) {
+        const uint32_t address = htonl(0x7F000000u | last);
+        if (address != self) {
+          list.push_back(address);
+        }
+      }
+    }
+    std::stringstream peers(REXCVAR_GET(lan_peers));
+    std::string item;
+    while (std::getline(peers, item, ',')) {
+      item.erase(0, item.find_first_not_of(" \t"));
+      item.erase(item.find_last_not_of(" \t") + 1);
+      if (item.empty()) {
+        continue;
+      }
+      if (const uint32_t address = Parse(item)) {
+        list.push_back(address);
+      } else {
+        REXSYS_WARN("system link: lan_peers entry '{}' is not an IPv4 address", item);
+      }
+    }
+    return list;
+  }();
+  return copies;
+}
+
+bool SendRealBroadcast() {
+  return !IsLoopback(LocalAddress());
+}
+
+std::vector<uint32_t> BroadcastAddresses() {
+  static const std::vector<uint32_t> addresses = [] {
+    std::vector<uint32_t> list{INADDR_BROADCAST};
+    const auto add = [&](uint32_t address, uint32_t mask) {
+      const uint32_t host = ntohl(address);
+      // Not loopback, nor link-local (169.254.x.x: an adapter without a network).
+      if ((host >> 24) == 127 || (host >> 16) == 0xA9FE || mask == 0) {
+        return;
+      }
+      const uint32_t broadcast = address | ~mask;
+      if (std::find(list.begin(), list.end(), broadcast) == list.end()) {
+        list.push_back(broadcast);
+      }
+    };
+#if REX_PLATFORM_WIN32
+    const SOCKET probe = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    INTERFACE_INFO interfaces[64];
+    DWORD bytes = 0;
+    if (probe != INVALID_SOCKET &&
+        WSAIoctl(probe, SIO_GET_INTERFACE_LIST, nullptr, 0, interfaces, sizeof(interfaces), &bytes,
+                 nullptr, nullptr) == 0) {
+      for (DWORD i = 0; i < bytes / sizeof(INTERFACE_INFO); ++i) {
+        const INTERFACE_INFO& info = interfaces[i];
+        if (!(info.iiFlags & IFF_UP) || (info.iiFlags & IFF_LOOPBACK)) {
+          continue;
+        }
+        add(info.iiAddress.AddressIn.sin_addr.s_addr, info.iiNetmask.AddressIn.sin_addr.s_addr);
+      }
+    }
+    if (probe != INVALID_SOCKET) {
+      closesocket(probe);
+    }
+#else
+    ifaddrs* interfaces = nullptr;
+    if (getifaddrs(&interfaces) == 0) {
+      for (ifaddrs* i = interfaces; i; i = i->ifa_next) {
+        if (!i->ifa_addr || !i->ifa_netmask || i->ifa_addr->sa_family != AF_INET ||
+            !(i->ifa_flags & IFF_UP) || (i->ifa_flags & IFF_LOOPBACK)) {
+          continue;
+        }
+        add(reinterpret_cast<sockaddr_in*>(i->ifa_addr)->sin_addr.s_addr,
+            reinterpret_cast<sockaddr_in*>(i->ifa_netmask)->sin_addr.s_addr);
+      }
+      freeifaddrs(interfaces);
+    }
+#endif
+    std::string text;
+    for (const uint32_t address : list) {
+      text += (text.empty() ? "" : ", ") + Dotted(address);
+    }
+    REXSYS_INFO("system link: broadcasts go to {}", text);
+    return list;
+  }();
+  return addresses;
+}
+
+std::string PlayerName() {
+  std::string name = REXCVAR_GET(player_name);
+  if (name.empty()) {
+    name = "Player" + std::to_string(ntohl(LocalAddress()) & 0xFF);
+  }
+  if (name.size() > 15) {
+    name.resize(15);
+  }
+  return name;
+}
+
+uint64_t PlayerXuid() {
+  // An offline XUID (0xE0...), distinct per address and name. Bits 54-55 stay
+  // clear: some titles refuse a XUID with them set.
+  const uint64_t body = Fnv(Dotted(LocalAddress()) + "/" + PlayerName()) & 0x0000FFFFFFFFFFFFull;
+  return 0xE000000000000000ull | body;
+}
+
+void Random(uint8_t* out, size_t length) {
+  static std::mt19937_64 random{std::random_device{}()};
+  std::lock_guard lock(g_random_mutex);
+  for (size_t i = 0; i < length; ++i) {
+    out[i] = uint8_t(random());
+  }
+}
+
+void FillHostSessionInfo(uint8_t* info, uint8_t* nonce, bool live_session) {
+  if (info) {
+    // XNKID: the top three bits give its kind - 0x00 System Link, 0x80 an
+    // online peer session.
+    uint8_t* kid = info;
+    Random(kid, 8);
+    kid[0] = uint8_t((kid[0] & 0x1F) | (live_session ? 0x80 : 0x00));
+    // XNADDR: ina, inaOnline, wPortOnline (big-endian), abEnet, abOnline.
+    uint8_t* host = info + 8;
+    std::memset(host, 0, 36);
+    const uint32_t address = LocalAddress();
+    std::memcpy(host + 0, &address, 4);
+    FillIdentity(address, host + 10, host + 16);
+    // XNKEY.
+    Random(info + 8 + 36, 16);
+  }
+  if (nonce) {
+    Random(nonce, 8);
+  }
+}
+
+}  // namespace rex::system::system_link
