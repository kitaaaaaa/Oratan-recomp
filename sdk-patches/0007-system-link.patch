+/**
+ * @file        rex/system/system_link.h
+ * @brief       --system_link: the console on a local network, for titles'
+ *              System Link (LAN) play.
+ *
+ * Off (the default), the console has no cable and a loopback address, as
+ * before. On, the console has the PC's LAN address (or --lan_address), an
+ * identity of its own (MAC, XUID, gamertag) so that two copies of a title tell
+ * each other apart, and a title's broadcasts reach the other copies: on the
+ * LAN as broadcasts on every network interface (plus a copy to each
+ * --lan_peers address), and between copies on one PC (--lan_address=
+ * 127.0.0.2, 127.0.0.3, ...) as a copy to each of the other loopback
+ * addresses 127.0.0.1-127.0.0.8.
+ *
+ * The socket fixes that came with it apply either way: addresses and ports
+ * in host byte order for sendto/recvfrom, overlapped WSARecvFrom and
+ * WSAGetOverlappedResult, socket-level option values in host format.
+ */
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex::system::system_link {
+
+bool Enabled();
+
+// --net_log: log the title's network calls (sockets, XNet, sessions).
+bool Logging();
+
+// This console's IPv4, network byte order.
+uint32_t LocalAddress();
+
+// Where an unaddressed bind goes, network byte order: --lan_address when set
+// (copies on one PC each need their own), otherwise any address.
+uint32_t BindAddress();
+
+// A distinct MAC address and online identification for an address.
+void FillIdentity(uint32_t address, uint8_t enet[6], uint8_t online[20]);
+
+// Where a broadcast is copied as unicast, network byte order.
+std::vector<uint32_t> BroadcastCopies();
+// Whether a real broadcast is sent too (not between copies on one PC).
+bool SendRealBroadcast();
+// Network byte order: 255.255.255.255, then each network interface's own
+// broadcast address (Windows sends 255.255.255.255 out of one interface
+// only, and a PC with VPN adapters often picks one of those).
+std::vector<uint32_t> BroadcastAddresses();
+
+// The signed-in player: an offline XUID and gamertag of this copy's own.
+uint64_t PlayerXuid();
+std::string PlayerName();
+
+// XSessionCreate as host: XSESSION_INFO (XNKID, the host's XNADDR, XNKEY; 60
+// bytes) and the nonce (8 bytes), either may be null.
+void FillHostSessionInfo(uint8_t* info, uint8_t* nonce, bool live_session);
+
+// Random bytes (XNetRandom; the stock constant 0xBB made every copy pick the
+// same "random" ids).
+void Random(uint8_t* out, size_t length);
+
+// Dotted text for an address in network byte order.
+std::string Dotted(uint32_t address);
+
+}  // namespace rex::system::system_link
