+// Overlapped receives (WSARecvFrom with an OVERLAPPED), after Xerenge's
+// poller (rexglue-xerenge xam_net.cpp). A receive that can't complete at once
+// waits here; a host thread polls its socket and, once a datagram is in,
+// writes it to the title's buffer, fills the OVERLAPPED and sets its event.
+// WSAGetOverlappedResult then hands over the byte count.
+namespace {
+struct PendingRecv {
+  uint32_t socket_handle;
+  uint32_t overlapped;
+  uint32_t buf;
+  uint32_t buf_len;
+  uint32_t from;
+  uint32_t fromlen;
+};
+std::mutex g_overlapped_mutex;
+std::vector<PendingRecv> g_pending_recvs;
+std::map<uint32_t, uint32_t> g_completed;  // OVERLAPPED guest address -> bytes
+
+constexpr uint32_t kWsaIoIncomplete = 996;
+constexpr uint32_t kWsaIoPending = 997;
+constexpr uint32_t kWsaEInval = 10022;
+constexpr uint32_t kWsaEWouldBlock = 10035;
+constexpr uint32_t kWsaENotSock = 10038;
+constexpr uint32_t kStatusPending = 0x103;
+
+// --net_log for calls the title repeats every frame: the first 40, then one in
+// 600.
+bool LogRepeated(std::atomic<uint32_t>& count) {
+  if (!system_link::Logging()) {
+    return false;
+  }
+  const uint32_t n = count++;
+  return n < 40 || n % 600 == 0;
+}
+
+uint32_t LastSocketError() {
+#if REX_PLATFORM_WIN32
+  return uint32_t(WSAGetLastError());
+#else
+  return (errno == EAGAIN || errno == EWOULDBLOCK) ? kWsaEWouldBlock : 10050;  // WSAENETDOWN
+#endif
+}
+
+// What a receive got: bytes (>= 0), or -1 with the error in `error`.
+int TryRecv(const PendingRecv& p, uint32_t* error) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(p.socket_handle);
+  if (!socket) {
+    *error = kWsaENotSock;
+    return -1;
+  }
+  if (!socket->Readable()) {
+    *error = kWsaEWouldBlock;
+    return -1;
+  }
+  auto* memory = REX_KERNEL_MEMORY();
+  N_XSOCKADDR_IN from;
+  uint32_t from_len = sizeof(XSOCKADDR_IN);
+  const int ret =
+      socket->RecvFrom(memory->TranslateVirtual<uint8_t*>(p.buf), p.buf_len, 0, &from, &from_len);
+  if (ret < 0) {
+    *error = LastSocketError();
+    return -1;
+  }
+  if (p.from) {
+    auto* guest_from = memory->TranslateVirtual<XSOCKADDR_IN*>(p.from);
+    guest_from->sin_family = from.sin_family;
+    guest_from->sin_port = from.sin_port;
+    guest_from->sin_addr = from.sin_addr;
+    std::memset(guest_from->x_sin_zero, 0, sizeof(guest_from->x_sin_zero));
+  }
+  if (p.fromlen) {
+    *memory->TranslateVirtual<rex::be<uint32_t>*>(p.fromlen) = sizeof(XSOCKADDR_IN);
+  }
+  return ret;
+}
+
+// Marks an OVERLAPPED done with `bytes` and sets its event.
+void CompleteOverlapped(uint32_t overlapped, uint32_t bytes) {
+  auto* ov = REX_KERNEL_MEMORY()->TranslateVirtual<XWSAOVERLAPPED*>(overlapped);
+  ov->internal = 0;
+  ov->internal_high = bytes;
+  {
+    std::lock_guard lock(g_overlapped_mutex);
+    g_completed[overlapped] = bytes;
+  }
+  if (ov->event_handle) {
+    xboxkrnl::xeNtSetEvent(ov->event_handle, nullptr);
+  }
+}
+
+void DropPendingRecvs(uint32_t socket_handle) {
+  std::lock_guard lock(g_overlapped_mutex);
+  g_pending_recvs.erase(std::remove_if(g_pending_recvs.begin(), g_pending_recvs.end(),
+                                       [&](const PendingRecv& p) {
+                                         return p.socket_handle == socket_handle;
+                                       }),
+                        g_pending_recvs.end());
+}
+
+void StartRecvPoller() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    std::thread([] {
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        std::vector<PendingRecv> work;
+        {
+          std::lock_guard lock(g_overlapped_mutex);
+          work = g_pending_recvs;
+        }
+        for (const PendingRecv& p : work) {
+          uint32_t error = 0;
+          const int ret = TryRecv(p, &error);
+          if (ret < 0 && error == kWsaEWouldBlock) {
+            continue;
+          }
+          {
+            // Gone since the copy (its socket closed, or a new receive on the
+            // same OVERLAPPED): not ours to complete.
+            std::lock_guard lock(g_overlapped_mutex);
+            auto it = std::find_if(g_pending_recvs.begin(), g_pending_recvs.end(),
+                                   [&](const PendingRecv& q) {
+                                     return q.overlapped == p.overlapped &&
+                                            q.socket_handle == p.socket_handle;
+                                   });
+            if (it == g_pending_recvs.end()) {
+              continue;
+            }
+            g_pending_recvs.erase(it);
+          }
+          CompleteOverlapped(p.overlapped, ret < 0 ? 0 : uint32_t(ret));
+        }
+      }
+    }).detach();
+  });
+}
+}  // namespace
