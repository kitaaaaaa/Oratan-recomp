+u32 NetDll_WSAGetOverlappedResult_entry(u32 caller, u32 socket, u32 overlapped_ptr,
+                                        mapped_u32 transferred, u32 wait, mapped_u32 flags) {
+  static std::atomic<uint32_t> log_count{0};
+  if (LogRepeated(log_count)) {
+    REXKRNL_INFO("net: WSAGetOverlappedResult {:08X} overlapped {:08X} wait {}", uint32_t(socket),
+                 uint32_t(overlapped_ptr), uint32_t(wait));
+  }
+  for (;;) {
+    {
+      std::lock_guard lock(g_overlapped_mutex);
+      auto it = g_completed.find(overlapped_ptr);
+      if (it != g_completed.end()) {
+        if (transferred) {
+          *transferred = it->second;
+        }
+        if (flags) {
+          *flags = 0;
+        }
+        g_completed.erase(it);
+        return 1;
+      }
+      const bool pending =
+          std::any_of(g_pending_recvs.begin(), g_pending_recvs.end(),
+                      [&](const PendingRecv& p) { return p.overlapped == overlapped_ptr; });
+      if (!wait || !pending) {
+        XThread::SetLastError(kWsaIoIncomplete);
+        return 0;
+      }
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+}
