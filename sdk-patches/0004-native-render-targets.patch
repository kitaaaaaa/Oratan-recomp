+// Root constants (b0), see Resolve.
+struct ResolveConstants {
+  float src_origin[2];  // source host pixel at the destination rectangle origin
+  float src_step[2];    // source host pixels per destination host pixel
+  float dst_origin[2];  // destination rectangle origin, host pixels
+  uint32_t sample_select;
+  float exp_scale;
+  uint32_t swap_rb;
+  float inv_src_size[2];  // reduction: 1 / source host size
+  uint32_t pad;
+};
+static_assert(sizeof(ResolveConstants) == 48);
+
+const char kShaderSource[] = R"(
+cbuffer C : register(b0) {
+  float2 src_origin;
+  float2 src_step;
+  float2 dst_origin;
+  uint sample_select;
+  float exp_scale;
+  uint swap_rb;
+  float2 inv_src_size;
+};
+Texture2D<float4> reduce_src : register(t0);
+SamplerState linear_clamp : register(s0);
+// Box filter of the source footprint of one destination pixel (4x4 bilinear
+// taps), so a draw at a lower scale sees an average like the original did.
+float4 PSReduce(float4 pos : SV_Position) : SV_Target {
+  float2 base = floor(pos.xy) * src_step;
+  float4 sum = 0.0;
+  [unroll] for (uint y = 0; y < 4; ++y) {
+    [unroll] for (uint x = 0; x < 4; ++x) {
+      float2 p = base + (float2(x, y) + 0.5) * 0.25 * src_step;
+      sum += reduce_src.SampleLevel(linear_clamp, p * inv_src_size, 0.0);
+    }
+  }
+  return sum * (1.0 / 16.0);
+}
+float4 VSMain(uint id : SV_VertexID) : SV_Position {
+  float2 uv = float2((id << 1) & 2, id & 2);
+  return float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+}
+int2 SourcePixel(float4 pos) {
+  return int2(floor(src_origin + (pos.xy - dst_origin) * src_step));
+}
+#if SAMPLES == 1
+Texture2D<float4> src_color : register(t0);
+Texture2D<float> src_depth : register(t0);
+Texture2D<uint2> src_stencil : register(t1);
+float4 LoadColor(int2 p, uint s) { return src_color.Load(int3(p, 0)); }
+float LoadDepth(int2 p, uint s) { return src_depth.Load(int3(p, 0)); }
+uint LoadStencil(int2 p, uint s) { return src_stencil.Load(int3(p, 0)).g; }
+#else
+Texture2DMS<float4> src_color : register(t0);
+Texture2DMS<float> src_depth : register(t0);
+Texture2DMS<uint2> src_stencil : register(t1);
+float4 LoadColor(int2 p, uint s) { return src_color.Load(p, s); }
+float LoadDepth(int2 p, uint s) { return src_depth.Load(p, s); }
+uint LoadStencil(int2 p, uint s) { return src_stencil.Load(p, s).g; }
+#endif
+float4 PSColor(float4 pos : SV_Position) : SV_Target {
+  int2 p = SourcePixel(pos);
+  float4 c;
+  // xenos::CopySampleSelect: 0-3 one sample, 4 = 0+1, 5 = 2+3, 6 = all four.
+  if (sample_select == 6 && SAMPLES >= 4) {
+    c = (LoadColor(p, 0) + LoadColor(p, 1) + LoadColor(p, 2) + LoadColor(p, 3)) * 0.25;
+  } else if ((sample_select == 4 || sample_select == 6) && SAMPLES >= 2) {
+    // Averaging all samples of a 2x render target (anti-aliasing option).
+    c = (LoadColor(p, 0) + LoadColor(p, 1)) * 0.5;
+  } else if (sample_select == 5 && SAMPLES >= 4) {
+    c = (LoadColor(p, 2) + LoadColor(p, 3)) * 0.5;
+  } else {
+    c = LoadColor(p, min(sample_select & 3, SAMPLES - 1));
+  }
+  c *= exp_scale;
+  return swap_rb ? c.bgra : c;
+}
+// Depth / stencil as the 32-bit D24S8 word (depth << 8 | stencil), read back
+// as k_8_8_8_8: R = stencil, G/B/A = depth bits 0-7 / 8-15 / 16-23.
+float4 PSDepth(float4 pos : SV_Position) : SV_Target {
+  int2 p = SourcePixel(pos);
+  uint s = min(sample_select & 3, SAMPLES - 1);
+  uint d24 = uint(round(saturate(LoadDepth(p, s)) * 16777215.0));
+  uint st = HAS_STENCIL ? LoadStencil(p, s) : 0u;
+  return float4(st, d24 & 0xFF, (d24 >> 8) & 0xFF, d24 >> 16) * (1.0 / 255.0);
+}
+)";
+
+bool Compile(pD3DCompile compile, const char* entry, const char* target, uint32_t samples,
+             bool has_stencil, std::vector<uint8_t>& out) {
+  char samples_text[8], stencil_text[8];
+  std::snprintf(samples_text, sizeof(samples_text), "%u", samples);
+  std::snprintf(stencil_text, sizeof(stencil_text), "%u", uint32_t(has_stencil));
+  D3D_SHADER_MACRO defines[] = {{"SAMPLES", samples_text}, {"HAS_STENCIL", stencil_text}, {}};
+  ID3DBlob* blob = nullptr;
+  ID3DBlob* errors = nullptr;
+  HRESULT hr = compile(kShaderSource, sizeof(kShaderSource) - 1, "native_textures", defines, nullptr,
+                       entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &blob, &errors);
+  if (FAILED(hr)) {
+    REXGPU_ERROR("NativeTextures: compiling {} failed: {}", entry,
+                 errors ? static_cast<const char*>(errors->GetBufferPointer()) : "?");
+    if (errors) errors->Release();
+    return false;
+  }
+  if (errors) errors->Release();
+  const uint8_t* p = static_cast<const uint8_t*>(blob->GetBufferPointer());
+  out.assign(p, p + blob->GetBufferSize());
+  blob->Release();
+  return true;
+}
+
+uint32_t SamplesIndex(uint32_t samples) { return samples >= 4 ? 2 : (samples >= 2 ? 1 : 0); }
+
+// The typeless family of the DXGI formats native textures use, so a texture
+// can be sampled through a different but bit-compatible view format.
+DXGI_FORMAT Family(DXGI_FORMAT f) {
+  switch (f) {
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_SNORM:
+    case DXGI_FORMAT_R8G8B8A8_UINT:
+      return DXGI_FORMAT_R8G8B8A8_TYPELESS;
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS:
+    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+    case DXGI_FORMAT_R16G16B16A16_UNORM:
+    case DXGI_FORMAT_R16G16B16A16_SNORM:
+      return DXGI_FORMAT_R16G16B16A16_TYPELESS;
+    case DXGI_FORMAT_R10G10B10A2_TYPELESS:
+    case DXGI_FORMAT_R10G10B10A2_UNORM:
+      return DXGI_FORMAT_R10G10B10A2_TYPELESS;
+    case DXGI_FORMAT_R8_TYPELESS:
+    case DXGI_FORMAT_R8_UNORM:
+    case DXGI_FORMAT_R8_SNORM:
+      return DXGI_FORMAT_R8_TYPELESS;
+    case DXGI_FORMAT_R8G8_TYPELESS:
+    case DXGI_FORMAT_R8G8_UNORM:
+    case DXGI_FORMAT_R8G8_SNORM:
+      return DXGI_FORMAT_R8G8_TYPELESS;
+    case DXGI_FORMAT_R16G16_TYPELESS:
+    case DXGI_FORMAT_R16G16_FLOAT:
+    case DXGI_FORMAT_R16G16_UNORM:
+    case DXGI_FORMAT_R16G16_SNORM:
+      return DXGI_FORMAT_R16G16_TYPELESS;
+    case DXGI_FORMAT_R16_TYPELESS:
+    case DXGI_FORMAT_R16_FLOAT:
+    case DXGI_FORMAT_R16_UNORM:
+    case DXGI_FORMAT_R16_SNORM:
+      return DXGI_FORMAT_R16_TYPELESS;
+    case DXGI_FORMAT_R32_TYPELESS:
+    case DXGI_FORMAT_R32_FLOAT:
+      return DXGI_FORMAT_R32_TYPELESS;
+    default:
+      return f;
+  }
+}
