diff --git a/include/rex/graphics/d3d12/native_textures.h b/include/rex/graphics/d3d12/native_textures.h
new file mode 100644
index 0000000..3d317e7
--- /dev/null
+++ b/include/rex/graphics/d3d12/native_textures.h
@@ -0,0 +1,157 @@
+/**
+ * Native render-target mode (Oratan-recomp).
+ *
+ * Resolves are copied on the host, at the render target's own resolution, into
+ * "native textures" keyed by their guest destination address, instead of being
+ * written to guest memory. Draws that sample one of those addresses bind the
+ * native texture. Nothing is written back to guest memory: the CPU never reads
+ * resolve results in this game (d3d12_readback_resolve is off by default).
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/graphics/xenos.h>
+#include <rex/ui/d3d12/d3d12_api.h>
+
+REXCVAR_DECLARE(bool, native_render_targets);
+REXCVAR_DECLARE(int32_t, native_resolution);
+REXCVAR_DECLARE(int32_t, native_msaa);
+
+namespace rex::graphics::d3d12 {
+
+class D3D12CommandProcessor;
+
+class NativeTextures {
+ public:
+  explicit NativeTextures(D3D12CommandProcessor& command_processor)
+      : command_processor_(command_processor) {}
+  ~NativeTextures() { Shutdown(); }
+
+  bool Initialize();
+  void Shutdown();
+
+  // The render target a resolve reads. The caller transitions the resource to
+  // a shader resource state before Resolve and back afterwards.
+  struct Source {
+    ID3D12Resource* resource = nullptr;
+    D3D12_CPU_DESCRIPTOR_HANDLE srv = {};
+    D3D12_CPU_DESCRIPTOR_HANDLE srv_stencil = {};  // ptr 0 if none
+    // Colour: view format to read the render target as floats with (the
+    // render target's own SRV may be a bit-exact integer view).
+    DXGI_FORMAT color_view_format = DXGI_FORMAT_UNKNOWN;
+    uint32_t samples = 1;
+    bool is_depth = false;
+    // Host pixels per guest pixel of the render target.
+    float scale_x = 1.0f, scale_y = 1.0f;
+  };
+  struct Copy {
+    // Guest pixels in the render target (window offset applied), exclusive end.
+    int32_t x0, y0, x1, y1;
+    // Destination: the base adjusted to the rectangle's 32x32 tile (as in
+    // draw_util::ResolveInfo::copy_dest_base) and the rectangle's offset
+    // within that tile, in guest pixels.
+    uint32_t dest_base;
+    uint32_t dest_x, dest_y;
+    uint32_t dest_pitch, dest_height;
+    xenos::TextureFormat dest_format;
+    uint32_t sample_select;  // xenos::CopySampleSelect
+    int32_t exp_bias;
+    bool swap_rb;
+  };
+  bool Resolve(const Source& source, const Copy& copy);
+
+  // Bindless descriptor index of the native texture for a texture fetch, or
+  // UINT32_MAX if the address isn't a native texture.
+  // draw_scale: the scale of the render target being drawn (a lower one gets a
+  // box-filtered copy of a higher resolution texture).
+  uint32_t GetBindlessSRV(uint32_t base_address, uint32_t width, uint32_t height,
+                          DXGI_FORMAT view_format, uint32_t host_swizzle, float draw_scale_x,
+                          float draw_scale_y);
+  // Set when this class bound its own render targets / pipeline during
+  // binding; the render target cache must rebind.
+  bool TakeRenderTargetsInvalidated() {
+    bool invalidated = render_targets_invalidated_;
+    render_targets_invalidated_ = false;
+    return invalidated;
+  }
+  // For presenting the front buffer.
+  ID3D12Resource* GetSwapTexture(uint32_t address, uint32_t width, uint32_t height,
+                                 D3D12_SHADER_RESOURCE_VIEW_DESC& srv_desc_out);
+
+  bool active() const { return !textures_.empty(); }
+
+  // Resource state native textures are kept in between resolves.
+  static constexpr D3D12_RESOURCE_STATES kReadState =
+      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+
+ private:
+  struct Texture {
+    uint32_t base;
+    uint32_t pitch, height;  // guest pixels
+    uint32_t bytes;          // guest memory span
+    xenos::TextureFormat format;
+    uint32_t bpp_log2;
+    DXGI_FORMAT resource_format, rtv_format;
+    float scale_x, scale_y;
+    uint32_t host_width, host_height;
+    ID3D12Resource* resource = nullptr;
+    uint32_t rtv_index = UINT32_MAX;
+    uint64_t version = 0;
+    // (view format << 32 | swizzle) -> bindless descriptor.
+    std::unordered_map<uint64_t, uint32_t> srvs;
+  };
+  // A texture sampled at a sub-rectangle of a native texture (different base or
+  // smaller size): a copy refreshed when the source changes.
+  struct Derived {
+    Texture texture;
+    uint32_t source_base;
+    uint32_t offset_x, offset_y;  // guest pixels in the source
+    uint64_t source_version = UINT64_MAX;
+  };
+
+  Texture* FindContaining(uint32_t address, uint32_t pitch, xenos::TextureFormat format,
+                          uint32_t& offset_x_out, uint32_t& offset_y_out);
+  Texture* FindForSampling(uint32_t address, uint32_t& offset_x_out, uint32_t& offset_y_out);
+  bool CreateTexture(Texture& texture);
+  void DestroyTexture(Texture& texture);
+  void ReleaseCompleted(bool all);
+  uint32_t GetSRV(Texture& texture, DXGI_FORMAT view_format, uint32_t host_swizzle);
+  Texture* GetReduced(Texture& source, float scale_x, float scale_y);
+  ID3D12PipelineState* GetPipeline(DXGI_FORMAT rtv_format, uint32_t samples, bool is_depth);
+
+  D3D12CommandProcessor& command_processor_;
+  bool initialized_ = false;
+
+  std::unordered_map<uint32_t, Texture> textures_;  // by base
+  std::unordered_map<uint64_t, Derived> derived_;   // by base << 32 | width << 16 | height
+  std::unordered_map<uint64_t, Derived> reduced_;   // by base << 32 | scale * 64
+  bool render_targets_invalidated_ = false;
+  // Sampled address inside a native texture -> that texture (base 0: none).
+  struct SamplingEntry {
+    uint32_t base, x, y;
+  };
+  std::unordered_map<uint32_t, SamplingEntry> sampling_cache_;
+
+  ID3D12DescriptorHeap* rtv_heap_ = nullptr;
+  uint32_t rtv_descriptor_size_ = 0;
+  std::vector<uint32_t> rtv_free_;
+  uint32_t rtv_allocated_ = 0;
+  static constexpr uint32_t kRTVCount = 2048;
+
+  std::vector<std::pair<uint64_t, ID3D12Resource*>> graveyard_;
+
+  ID3D12RootSignature* root_signature_ = nullptr;
+  std::vector<uint8_t> vs_;
+  std::vector<uint8_t> ps_color_[3];  // 1, 2, 4 samples
+  std::vector<uint8_t> ps_depth_[3];
+  std::vector<uint8_t> ps_reduce_;
+  std::unordered_map<uint64_t, ID3D12PipelineState*> pipelines_;
+};
+
+}  // namespace rex::graphics::d3d12
