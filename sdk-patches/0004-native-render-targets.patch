+uint32_t D3D12TextureCache::GetNativeBindlessSRVIndex(
+    const D3D12Shader::TextureBinding& host_shader_binding) {
+  NativeTextures* native_textures = command_processor_.GetNativeTextures();
+  if (!native_textures) {
+    return UINT32_MAX;
+  }
+  const TextureBinding* binding = GetValidTextureBinding(host_shader_binding.fetch_constant);
+  if (!binding || binding->key.dimension != xenos::DataDimension::k2DOrStacked ||
+      (host_shader_binding.dimension != xenos::FetchOpDimension::k2D &&
+       host_shader_binding.dimension != xenos::FetchOpDimension::k1D)) {
+    return UINT32_MAX;
+  }
+  DXGI_FORMAT view_format = host_shader_binding.is_signed
+                                ? host_formats_[uint32_t(binding->key.format)].dxgi_format_signed
+                                : GetDXGIUnormFormat(binding->key);
+  return native_textures->GetBindlessSRV(
+      binding->key.base_page << 12, binding->key.GetWidth(), binding->key.GetHeight(), view_format,
+      binding->host_swizzle, command_processor_.GetNativeDrawScaleX(),
+      command_processor_.GetNativeDrawScaleY());
+}
+
+void D3D12TextureCache::PrepareNativeTextures(
