@@ -62,9 +62,44 @@ class D3D12RenderTargetCache final : public RenderTargetCache {
   void InvalidateCommandListRenderTargets() {
     are_current_command_list_render_targets_valid_ = false;
   }
+  // After something else bound render targets in the middle of a draw's setup.
+  void RebindCommandListRenderTargets() {
+    are_current_command_list_render_targets_valid_ = false;
+    SetCommandListRenderTargets(last_update_accumulated_render_targets());
+  }
 
   bool msaa_2x_supported() const { return msaa_2x_supported_; }
 
+  void GetNativeScale(RenderTargetKey key, float& x_out, float& y_out) const override;
+  // Native mode: host sample count of a render target (the anti-aliasing
+  // option applies to scaled render targets the game multisamples).
+  xenos::MsaaSamples GetNativeHostMsaa(RenderTargetKey key) const;
+  // For the pipeline of the current draw.
+  xenos::MsaaSamples GetCurrentNativeHostMsaa(xenos::MsaaSamples guest_msaa) const {
+    if (!native_render_targets_) {
+      return guest_msaa;
+    }
+    RenderTarget* const* bound = last_update_accumulated_render_targets();
+    for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+      if (bound[i]) {
+        return GetNativeHostMsaa(bound[i]->key());
+      }
+    }
+    return guest_msaa;
+  }
+  bool native_render_targets() const { return native_render_targets_; }
+  // Native scale of the render targets bound by the last Update (1 if none).
+  void GetCurrentNativeScale(float& x_out, float& y_out) const {
+    x_out = y_out = 1.0f;
+    RenderTarget* const* bound = last_update_accumulated_render_targets();
+    for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+      if (bound[i]) {
+        GetNativeScale(bound[i]->key(), x_out, y_out);
+        return;
+      }
+    }
+  }
+
   void WriteEdramRawSRVDescriptor(D3D12_CPU_DESCRIPTOR_HANDLE handle);
   void WriteEdramRawUAVDescriptor(D3D12_CPU_DESCRIPTOR_HANDLE handle);
   void WriteEdramUintPow2SRVDescriptor(D3D12_CPU_DESCRIPTOR_HANDLE handle,
