+void D3D12RenderTargetCache::GetNativeScale(RenderTargetKey key, float& x_out,
+                                            float& y_out) const {
+  x_out = float(draw_resolution_scale_x());
+  y_out = float(draw_resolution_scale_y());
+  int32_t height = REXCVAR_GET(native_resolution);
+  if (!native_render_targets_ || height <= 0) {
+    return;
+  }
+  // Virtual-On Oratorio Tangram: the 3D scene (and the shadow map and tone
+  // mapping, which share its 1040-pixel pitch) is 1024x1024, stretched to the
+  // 16:9 frame - render it at exactly the output size. The 1280x720 frame
+  // (2D and the composite) scales uniformly. Everything else stays 1x.
+  uint32_t width = key.GetWidth();
+  // The shadow pass (1x, drawn with depth: class 1, and its depth buffer)
+  // stays 1x like on the console; it is cleared through a 4x MSAA alias,
+  // which only EDRAM transfers at the same scale reproduce.
+  bool shadow_pass = key.msaa_samples == xenos::MsaaSamples::k1X &&
+                     (key.is_depth || key.native_class);
+  if (width == 1040 && !shadow_pass) {
+    x_out = float(height) * (16.0f / 9.0f) / 1024.0f;
+    y_out = float(height) / 1024.0f;
+  } else if (width == 1280 && key.msaa_samples == xenos::MsaaSamples::k1X) {
+    x_out = y_out = float(height) / 720.0f;
+  } else {
+    x_out = y_out = 1.0f;
+  }
+}
+
+xenos::MsaaSamples D3D12RenderTargetCache::GetNativeHostMsaa(RenderTargetKey key) const {
+  int32_t option = REXCVAR_GET(native_msaa);
+  if (!native_render_targets_ || option <= 0 || key.msaa_samples == xenos::MsaaSamples::k1X) {
+    return key.msaa_samples;
+  }
+  float scale_x, scale_y;
+  GetNativeScale(key, scale_x, scale_y);
+  if (scale_x == 1.0f && scale_y == 1.0f) {
+    // EDRAM transfers between 1x-scale render targets assume the guest layout.
+    return key.msaa_samples;
+  }
+  if (option >= 4) {
+    return xenos::MsaaSamples::k4X;
+  }
+  if (option >= 2) {
+    return xenos::MsaaSamples::k2X;
+  }
+  return xenos::MsaaSamples::k1X;
+}
