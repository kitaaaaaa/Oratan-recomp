+  // Native render-target mode (Oratan-recomp): EDRAM ownership is still
+  // tracked (resolve clears use it) but no contents are transferred between
+  // render targets sharing EDRAM - each render target is its own host texture.
+  bool native_render_targets_ = false;
+  // Native mode: the class of the colour render target last drawn with this
+  // key (without the class bit).
+  std::unordered_map<uint32_t, uint32_t> native_last_class_;
