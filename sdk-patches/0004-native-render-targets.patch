+
+bool NativeTextures::Initialize() {
+  if (initialized_) {
+    return true;
+  }
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+
+  HMODULE compiler = LoadLibraryW(L"D3DCompiler_47.dll");
+  auto compile = compiler ? pD3DCompile(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+  if (!compile) {
+    REXGPU_ERROR("NativeTextures: D3DCompiler_47.dll / D3DCompile not available");
+    return false;
+  }
+  bool ok = Compile(compile, "VSMain", "vs_5_0", 1, false, vs_);
+  ok = ok && Compile(compile, "PSReduce", "ps_5_0", 1, false, ps_reduce_);
+  for (uint32_t i = 0; ok && i < 3; ++i) {
+    ok = Compile(compile, "PSColor", "ps_5_0", 1u << i, false, ps_color_[i]) &&
+         Compile(compile, "PSDepth", "ps_5_0", 1u << i, true, ps_depth_[i]);
+  }
+  if (!ok) {
+    return false;
+  }
+
+  D3D12_DESCRIPTOR_RANGE ranges[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    ranges[i].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    ranges[i].NumDescriptors = 1;
+    ranges[i].BaseShaderRegister = i;
+    ranges[i].RegisterSpace = 0;
+    ranges[i].OffsetInDescriptorsFromTableStart = 0;
+  }
+  D3D12_ROOT_PARAMETER params[3] = {};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants.ShaderRegister = 0;
+  params[0].Constants.RegisterSpace = 0;
+  params[0].Constants.Num32BitValues = sizeof(ResolveConstants) / sizeof(uint32_t);
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  for (uint32_t i = 0; i < 2; ++i) {
+    params[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    params[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    params[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC rs_desc = {};
+  rs_desc.NumParameters = 3;
+  rs_desc.pParameters = params;
+  D3D12_STATIC_SAMPLER_DESC sampler = {};
+  sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+  sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.MaxLOD = D3D12_FLOAT32_MAX;
+  sampler.ShaderRegister = 0;
+  sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  rs_desc.NumStaticSamplers = 1;
+  rs_desc.pStaticSamplers = &sampler;
+  root_signature_ = ui::d3d12::util::CreateRootSignature(provider, rs_desc);
+  if (!root_signature_) {
+    REXGPU_ERROR("NativeTextures: failed to create the root signature");
+    return false;
+  }
+
+  D3D12_DESCRIPTOR_HEAP_DESC heap_desc = {};
+  heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+  heap_desc.NumDescriptors = kRTVCount;
+  if (FAILED(device->CreateDescriptorHeap(&heap_desc, IID_PPV_ARGS(&rtv_heap_)))) {
+    REXGPU_ERROR("NativeTextures: failed to create the RTV heap");
+    return false;
+  }
+  rtv_descriptor_size_ = provider.GetRTVDescriptorSize();
+  initialized_ = true;
+  REXGPU_INFO("NativeTextures: native render-target mode enabled");
+  return true;
+}
+
+void NativeTextures::Shutdown() {
+  for (auto& [base, texture] : textures_) {
+    DestroyTexture(texture);
+  }
+  textures_.clear();
+  for (auto& [key, derived] : derived_) {
+    DestroyTexture(derived.texture);
+  }
+  derived_.clear();
+  for (auto& [key, reduced] : reduced_) {
+    DestroyTexture(reduced.texture);
+  }
+  reduced_.clear();
+  for (auto& [key, pipeline] : pipelines_) {
+    if (pipeline) pipeline->Release();
+  }
+  pipelines_.clear();
+  ReleaseCompleted(true);
+  ui::d3d12::util::ReleaseAndNull(root_signature_);
+  ui::d3d12::util::ReleaseAndNull(rtv_heap_);
+  initialized_ = false;
+}
+
+void NativeTextures::DestroyTexture(Texture& texture) {
+  if (initialized_) {
+    for (auto& [key, index] : texture.srvs) {
+      command_processor_.ReleaseViewBindlessDescriptorImmediately(index);
+    }
+  }
+  texture.srvs.clear();
+  if (texture.rtv_index != UINT32_MAX) {
+    rtv_free_.push_back(texture.rtv_index);
+    texture.rtv_index = UINT32_MAX;
+  }
+  if (texture.resource) {
+    // The GPU may still use it: release once the current submission completes.
+    graveyard_.emplace_back(command_processor_.GetCurrentSubmission(), texture.resource);
+    texture.resource = nullptr;
+  }
+}
+
+void NativeTextures::ReleaseCompleted(bool all) {
+  uint64_t completed = command_processor_.GetCompletedSubmission();
+  for (auto it = graveyard_.begin(); it != graveyard_.end();) {
+    if (all || it->first <= completed) {
+      it->second->Release();
+      it = graveyard_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+bool NativeTextures::CreateTexture(Texture& texture) {
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  D3D12_RESOURCE_DESC desc = {};
+  desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  desc.Width = texture.host_width;
+  desc.Height = texture.host_height;
+  desc.DepthOrArraySize = 1;
+  desc.MipLevels = 1;
+  desc.Format = texture.resource_format;
+  desc.SampleDesc.Count = 1;
+  desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  desc.Flags = texture.rtv_format != DXGI_FORMAT_UNKNOWN ? D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET
+                                                         : D3D12_RESOURCE_FLAG_NONE;
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                             D3D12_HEAP_FLAG_NONE, &desc, kReadState, nullptr,
+                                             IID_PPV_ARGS(&texture.resource)))) {
+    REXGPU_ERROR("NativeTextures: failed to create a {}x{} texture", texture.host_width,
+                 texture.host_height);
+    return false;
+  }
+  if (texture.rtv_format != DXGI_FORMAT_UNKNOWN) {
+    if (!rtv_free_.empty()) {
+      texture.rtv_index = rtv_free_.back();
+      rtv_free_.pop_back();
+    } else if (rtv_allocated_ < kRTVCount) {
+      texture.rtv_index = rtv_allocated_++;
+    } else {
+      REXGPU_ERROR("NativeTextures: out of RTV descriptors");
+      ui::d3d12::util::ReleaseAndNull(texture.resource);
+      return false;
+    }
+    D3D12_RENDER_TARGET_VIEW_DESC rtv = {};
+    rtv.Format = texture.rtv_format;
+    rtv.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
+    D3D12_CPU_DESCRIPTOR_HANDLE handle = rtv_heap_->GetCPUDescriptorHandleForHeapStart();
+    handle.ptr += size_t(texture.rtv_index) * rtv_descriptor_size_;
+    device->CreateRenderTargetView(texture.resource, &rtv, handle);
+  }
+  return true;
+}
+
+NativeTextures::Texture* NativeTextures::FindContaining(uint32_t address, uint32_t pitch,
+                                                        xenos::TextureFormat format,
+                                                        uint32_t& offset_x_out,
+                                                        uint32_t& offset_y_out) {
+  // An exact base match first: textures may overlap (a texture can be
+  // resolved into a sub-rectangle of a larger one that is sampled separately).
+  auto exact = textures_.find(address);
+  if (exact != textures_.end() && exact->second.pitch == pitch &&
+      exact->second.format == format) {
+    offset_x_out = offset_y_out = 0;
+    return &exact->second;
+  }
+  for (auto& [base, texture] : textures_) {
+    if (address < texture.base || address >= texture.base + texture.bytes ||
+        texture.pitch != pitch || texture.format != format) {
+      continue;
+    }
+    int32_t delta = int32_t(address - texture.base);
+    // Resolve destinations are 32x32-tile aligned within the texture.
+    for (uint32_t y = 0; y < texture.height; y += 8) {
+      for (uint32_t x = 0; x < texture.pitch; x += 8) {
+        if (texture_util::GetTiledOffset2D(int32_t(x), int32_t(y), texture.pitch,
+                                           texture.bpp_log2) == delta) {
+          offset_x_out = x;
+          offset_y_out = y;
+          return &texture;
+        }
+      }
+    }
+  }
+  return nullptr;
+}
+
+NativeTextures::Texture* NativeTextures::FindForSampling(uint32_t address, uint32_t& offset_x_out,
+                                                         uint32_t& offset_y_out) {
+  auto it = textures_.find(address);
+  if (it != textures_.end()) {
+    offset_x_out = offset_y_out = 0;
+    return &it->second;
+  }
+  auto cached = sampling_cache_.find(address);
+  if (cached != sampling_cache_.end()) {
+    auto source = textures_.find(cached->second.base);
+    if (source == textures_.end()) {
+      return nullptr;
+    }
+    offset_x_out = cached->second.x;
+    offset_y_out = cached->second.y;
+    return &source->second;
+  }
+  Texture* found = nullptr;
+  for (auto& [base, texture] : textures_) {
+    if (address > texture.base && address < texture.base + texture.bytes) {
+      found = FindContaining(address, texture.pitch, texture.format, offset_x_out, offset_y_out);
+      if (found) {
+        break;
+      }
+    }
+  }
+  sampling_cache_[address] = found ? SamplingEntry{found->base, offset_x_out, offset_y_out}
+                                   : SamplingEntry{0, 0, 0};
+  return found;
+}
+
+ID3D12PipelineState* NativeTextures::GetPipeline(DXGI_FORMAT rtv_format, uint32_t samples,
+                                                 bool is_depth) {
+  uint64_t key = (uint64_t(rtv_format) << 8) | (uint64_t(samples) << 1) | uint64_t(is_depth);
+  auto it = pipelines_.find(key);
+  if (it != pipelines_.end()) {
+    return it->second;
+  }
+  const std::vector<uint8_t>& ps =
+      !samples ? ps_reduce_
+               : (is_depth ? ps_depth_[SamplesIndex(samples)] : ps_color_[SamplesIndex(samples)]);
+  D3D12_GRAPHICS_PIPELINE_STATE_DESC desc = {};
+  desc.pRootSignature = root_signature_;
+  desc.VS.pShaderBytecode = vs_.data();
+  desc.VS.BytecodeLength = vs_.size();
+  desc.PS.pShaderBytecode = ps.data();
+  desc.PS.BytecodeLength = ps.size();
+  desc.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+  desc.SampleMask = UINT_MAX;
+  desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+  desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+  desc.RasterizerState.DepthClipEnable = TRUE;
+  desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+  desc.NumRenderTargets = 1;
+  desc.RTVFormats[0] = rtv_format;
+  desc.SampleDesc.Count = 1;
+  ID3D12PipelineState* pipeline = nullptr;
+  if (FAILED(command_processor_.GetD3D12Provider().GetDevice()->CreateGraphicsPipelineState(
+          &desc, IID_PPV_ARGS(&pipeline)))) {
+    REXGPU_ERROR("NativeTextures: failed to create a resolve pipeline (format {}, {} samples)",
+                 uint32_t(rtv_format), samples);
+    pipeline = nullptr;
+  }
+  pipelines_.emplace(key, pipeline);
+  return pipeline;
+}
+
+bool NativeTextures::Resolve(const Source& source, const Copy& copy) {
+  if (!initialized_ || copy.x1 <= copy.x0 || copy.y1 <= copy.y0) {
+    return false;
+  }
+  ReleaseCompleted(false);
+  const FormatInfo* format_info = FormatInfo::Get(copy.dest_format);
+  D3D12TextureCache& texture_cache = command_processor_.GetTextureCache();
+
+  // Find the destination: a texture containing RB_COPY_DEST_BASE (later bands
+  // of a tiled render), or a new one.
+  uint32_t band_x = 0, band_y = 0;
+  Texture* dest =
+      FindContaining(copy.dest_base, copy.dest_pitch, copy.dest_format, band_x, band_y);
+  if (dest && (dest->scale_x != source.scale_x || dest->scale_y != source.scale_y) &&
+      dest->base == copy.dest_base) {
+    // Same base resolved from a differently scaled render target: recreate.
+    uint32_t base = dest->base;
+    DestroyTexture(*dest);
+    textures_.erase(base);
+    sampling_cache_.clear();
+    dest = nullptr;
+  }
+  if (!dest) {
+    Texture texture;
+    texture.base = copy.dest_base;
+    texture.pitch = copy.dest_pitch;
+    texture.height = copy.dest_height;
+    texture.format = copy.dest_format;
+    texture.bpp_log2 = rex::log2_floor(std::max(format_info->bits_per_pixel >> 3, 1u));
+    texture.bytes = texture_util::GetTiledAddressUpperBound2D(
+        texture.pitch, texture.height, texture.pitch, texture.bpp_log2);
+    texture.resource_format = texture_cache.GetDXGIResourceFormat(copy.dest_format, 1, 1);
+    texture.rtv_format = texture_cache.GetDXGIUnormFormat(copy.dest_format, 1, 1);
+    texture.scale_x = source.scale_x;
+    texture.scale_y = source.scale_y;
+    texture.host_width = std::max(1u, uint32_t(std::lround(texture.pitch * texture.scale_x)));
+    texture.host_height = std::max(1u, uint32_t(std::lround(texture.height * texture.scale_y)));
+    if (texture.resource_format == DXGI_FORMAT_UNKNOWN ||
+        texture.rtv_format == DXGI_FORMAT_UNKNOWN) {
+      REXGPU_WARN("NativeTextures: resolve to unsupported format {}", uint32_t(copy.dest_format));
+      return false;
+    }
+    if (!CreateTexture(texture)) {
+      return false;
+    }
+    dest = &textures_.emplace(texture.base, std::move(texture)).first->second;
+    sampling_cache_.clear();
+  }
+
+  ID3D12PipelineState* pipeline = GetPipeline(dest->rtv_format, source.samples, source.is_depth);
+  if (!pipeline) {
+    return false;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    return false;
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  if (!source.is_depth && source.color_view_format != DXGI_FORMAT_UNKNOWN) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv = {};
+    srv.Format = source.color_view_format;
+    srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    if (source.samples > 1) {
+      srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DMS;
+    } else {
+      srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+      srv.Texture2D.MipLevels = 1;
+    }
+    device->CreateShaderResourceView(source.resource, &srv, descriptors[0].first);
+  } else {
+    device->CopyDescriptorsSimple(1, descriptors[0].first, source.srv,
+                                  D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  }
+  device->CopyDescriptorsSimple(1, descriptors[1].first,
+                                source.srv_stencil.ptr ? source.srv_stencil : source.srv,
+                                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+
+  // Destination rectangle in host pixels (dest is at the same coordinates as
+  // the source rectangle, relative to the band).
+  float dx0 = float(band_x + copy.dest_x) * dest->scale_x;
+  float dy0 = float(band_y + copy.dest_y) * dest->scale_y;
+  float dx1 = float(band_x + copy.dest_x + uint32_t(copy.x1 - copy.x0)) * dest->scale_x;
+  float dy1 = float(band_y + copy.dest_y + uint32_t(copy.y1 - copy.y0)) * dest->scale_y;
+  D3D12_RECT scissor;
+  scissor.left = LONG(std::lround(dx0));
+  scissor.top = LONG(std::lround(dy0));
+  scissor.right = std::min(LONG(std::lround(dx1)), LONG(dest->host_width));
+  scissor.bottom = std::min(LONG(std::lround(dy1)), LONG(dest->host_height));
+  if (scissor.right <= scissor.left || scissor.bottom <= scissor.top) {
+    return true;
+  }
+  D3D12_VIEWPORT viewport;
+  viewport.TopLeftX = float(scissor.left);
+  viewport.TopLeftY = float(scissor.top);
+  viewport.Width = float(scissor.right - scissor.left);
+  viewport.Height = float(scissor.bottom - scissor.top);
+  viewport.MinDepth = 0.0f;
+  viewport.MaxDepth = 1.0f;
+
+  ResolveConstants constants = {};
+  constants.dst_origin[0] = float(scissor.left);
+  constants.dst_origin[1] = float(scissor.top);
+  constants.src_step[0] = source.scale_x / dest->scale_x;
+  constants.src_step[1] = source.scale_y / dest->scale_y;
+  constants.src_origin[0] = float(copy.x0) * source.scale_x +
+                            (float(scissor.left) - dx0) * constants.src_step[0];
+  constants.src_origin[1] = float(copy.y0) * source.scale_y +
+                            (float(scissor.top) - dy0) * constants.src_step[1];
+  constants.sample_select = copy.sample_select;
+  constants.exp_scale = std::ldexp(1.0f, copy.exp_bias);
+  constants.swap_rb = copy.swap_rb ? 1 : 0;
+
+  command_processor_.PushTransitionBarrier(dest->resource, kReadState,
+                                           D3D12_RESOURCE_STATE_RENDER_TARGET);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_heap_->GetCPUDescriptorHandleForHeapStart();
+  rtv.ptr += size_t(dest->rtv_index) * rtv_descriptor_size_;
+  command_list.D3DOMSetRenderTargets(1, &rtv, FALSE, nullptr);
+  command_processor_.SetExternalGraphicsRootSignature(root_signature_);
+  command_processor_.SetExternalPipeline(pipeline);
+  command_list.D3DSetGraphicsRoot32BitConstants(0, sizeof(constants) / sizeof(uint32_t),
+                                                &constants, 0);
+  command_list.D3DSetGraphicsRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetGraphicsRootDescriptorTable(2, descriptors[1].second);
+  command_processor_.SetViewport(viewport);
+  command_processor_.SetScissorRect(scissor);
+  command_processor_.SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  command_list.D3DDrawInstanced(3, 1, 0, 0);
+  command_processor_.PushTransitionBarrier(dest->resource, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                                           kReadState);
+  ++dest->version;
+  return true;
+}
+
+uint32_t NativeTextures::GetSRV(Texture& texture, DXGI_FORMAT view_format, uint32_t host_swizzle) {
+  if (view_format == DXGI_FORMAT_UNKNOWN || Family(view_format) != Family(texture.rtv_format)) {
+    view_format = texture.rtv_format;
+  }
+  uint64_t key = (uint64_t(view_format) << 32) | host_swizzle;
+  auto it = texture.srvs.find(key);
+  if (it != texture.srvs.end()) {
+    return it->second;
+  }
+  uint32_t index = command_processor_.RequestPersistentViewBindlessDescriptor();
+  if (index == UINT32_MAX) {
+    return UINT32_MAX;
+  }
+  D3D12_SHADER_RESOURCE_VIEW_DESC desc = {};
+  desc.Format = view_format;
+  desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+  desc.Texture2DArray.MipLevels = 1;
+  desc.Texture2DArray.ArraySize = 1;
+  desc.Shader4ComponentMapping =
+      host_swizzle | D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  provider.GetDevice()->CreateShaderResourceView(
+      texture.resource, &desc,
+      provider.OffsetViewDescriptor(command_processor_.GetViewBindlessHeapCPUStart(), index));
+  texture.srvs.emplace(key, index);
+  return index;
+}
+
+NativeTextures::Texture* NativeTextures::GetReduced(Texture& source, float scale_x,
+                                                   float scale_y) {
+  uint64_t key = (uint64_t(source.base) << 32) | (uint64_t(std::lround(scale_x * 64.0f)) << 16) |
+                 uint64_t(std::lround(scale_y * 64.0f));
+  Derived& reduced = reduced_[key];
+  Texture& texture = reduced.texture;
+  uint32_t host_width = std::max(1u, uint32_t(std::lround(source.pitch * scale_x)));
+  uint32_t host_height = std::max(1u, uint32_t(std::lround(source.height * scale_y)));
+  if (!texture.resource || texture.host_width != host_width ||
+      texture.host_height != host_height || texture.resource_format != source.resource_format) {
+    DestroyTexture(texture);
+    texture = Texture();
+    texture.base = source.base;
+    texture.pitch = source.pitch;
+    texture.height = source.height;
+    texture.format = source.format;
+    texture.bpp_log2 = source.bpp_log2;
+    texture.resource_format = source.resource_format;
+    texture.rtv_format = source.rtv_format;
+    texture.scale_x = scale_x;
+    texture.scale_y = scale_y;
+    texture.host_width = host_width;
+    texture.host_height = host_height;
+    if (!CreateTexture(texture)) {
+      return nullptr;
+    }
+    reduced.source_version = UINT64_MAX;
+  }
+  if (reduced.source_version == source.version) {
+    return &texture;
+  }
+  ID3D12PipelineState* pipeline = GetPipeline(texture.rtv_format, 0, false);
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!pipeline || !command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    return nullptr;
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv = {};
+  srv.Format = source.rtv_format;
+  srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv.Texture2D.MipLevels = 1;
+  srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  device->CreateShaderResourceView(source.resource, &srv, descriptors[0].first);
+  device->CreateShaderResourceView(source.resource, &srv, descriptors[1].first);
+  ResolveConstants constants = {};
+  constants.src_step[0] = float(source.host_width) / float(host_width);
+  constants.src_step[1] = float(source.host_height) / float(host_height);
+  constants.inv_src_size[0] = 1.0f / float(source.host_width);
+  constants.inv_src_size[1] = 1.0f / float(source.host_height);
+  D3D12_VIEWPORT viewport = {0.0f, 0.0f, float(host_width), float(host_height), 0.0f, 1.0f};
+  D3D12_RECT scissor = {0, 0, LONG(host_width), LONG(host_height)};
+  command_processor_.PushTransitionBarrier(texture.resource, kReadState,
+                                           D3D12_RESOURCE_STATE_RENDER_TARGET);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_heap_->GetCPUDescriptorHandleForHeapStart();
+  rtv.ptr += size_t(texture.rtv_index) * rtv_descriptor_size_;
+  command_list.D3DOMSetRenderTargets(1, &rtv, FALSE, nullptr);
+  command_processor_.SetExternalGraphicsRootSignature(root_signature_);
+  command_processor_.SetExternalPipeline(pipeline);
+  command_list.D3DSetGraphicsRoot32BitConstants(0, sizeof(constants) / sizeof(uint32_t),
+                                                &constants, 0);
+  command_list.D3DSetGraphicsRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetGraphicsRootDescriptorTable(2, descriptors[1].second);
+  command_processor_.SetViewport(viewport);
+  command_processor_.SetScissorRect(scissor);
+  command_processor_.SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  command_list.D3DDrawInstanced(3, 1, 0, 0);
+  command_processor_.PushTransitionBarrier(texture.resource, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                                           kReadState);
+  command_processor_.SubmitBarriers();
+  reduced.source_version = source.version;
+  render_targets_invalidated_ = true;
+  return &texture;
+}
+
+uint32_t NativeTextures::GetBindlessSRV(uint32_t base_address, uint32_t width, uint32_t height,
+                                        DXGI_FORMAT view_format, uint32_t host_swizzle,
+                                        float draw_scale_x, float draw_scale_y) {
+  if (!initialized_ || textures_.empty()) {
+    return UINT32_MAX;
+  }
+  uint32_t offset_x, offset_y;
+  Texture* source = FindForSampling(base_address, offset_x, offset_y);
+  if (!source) {
+    for (auto& [base, texture] : textures_) {
+      if (base_address > texture.base && base_address < texture.base + texture.bytes) {
+        static uint32_t misses = 0;
+        if (misses++ < 16) {
+          REXGPU_WARN("NativeTextures: {:08X} {}x{} inside native texture {:08X} {}x{} but not "
+                      "at a resolvable offset",
+                      base_address, width, height, texture.base, texture.pitch, texture.height);
+        }
+        break;
+      }
+    }
+    return UINT32_MAX;
+  }
+  if (!offset_x && !offset_y && width == source->pitch && height == source->height) {
+    if (draw_scale_x == 1.0f && draw_scale_y == 1.0f &&
+        (source->scale_x > 1.0f || source->scale_y > 1.0f)) {
+      // Drawn into an unscaled render target (the bloom / luminance chain,
+      // made for 2:1 steps from the 1024x1024 scene): sample a box-filtered
+      // copy at 1x. Scaled draws (the composite, which stretches the scene to
+      // the frame anyway) sample the full-resolution texture.
+      Texture* reduced = GetReduced(*source, std::min(source->scale_x, draw_scale_x),
+                                    std::min(source->scale_y, draw_scale_y));
+      if (reduced) {
+        return GetSRV(*reduced, view_format, host_swizzle);
+      }
+    }
+    return GetSRV(*source, view_format, host_swizzle);
+  }
+  if (offset_x + width > source->pitch || offset_y + height > source->height) {
+    static uint32_t misses = 0;
+    if (misses++ < 16) {
+      REXGPU_WARN("NativeTextures: {:08X} {}x{} only partly inside native texture {:08X} {}x{}",
+                  base_address, width, height, source->base, source->pitch, source->height);
+    }
+    return UINT32_MAX;
+  }
+  // Sub-rectangle: a derived copy.
+  uint64_t key = (uint64_t(base_address) << 32) | (uint64_t(width) << 16) | height;
+  Derived& derived = derived_[key];
+  Texture& texture = derived.texture;
+  uint32_t src_x = uint32_t(std::lround(offset_x * source->scale_x));
+  uint32_t src_y = uint32_t(std::lround(offset_y * source->scale_y));
+  uint32_t host_width = std::max(1u, uint32_t(std::lround(width * source->scale_x)));
+  uint32_t host_height = std::max(1u, uint32_t(std::lround(height * source->scale_y)));
+  host_width = std::min(host_width, source->host_width - std::min(src_x, source->host_width));
+  host_height = std::min(host_height, source->host_height - std::min(src_y, source->host_height));
+  if (!host_width || !host_height) {
+    return UINT32_MAX;
+  }
+  if (!texture.resource || derived.source_base != source->base ||
+      texture.host_width != host_width || texture.host_height != host_height ||
+      texture.resource_format != source->resource_format) {
+    DestroyTexture(texture);
+    texture = Texture();
+    texture.base = base_address;
+    texture.pitch = width;
+    texture.height = height;
+    texture.format = source->format;
+    texture.bpp_log2 = source->bpp_log2;
+    texture.resource_format = source->resource_format;
+    texture.rtv_format = DXGI_FORMAT_UNKNOWN;
+    texture.scale_x = source->scale_x;
+    texture.scale_y = source->scale_y;
+    texture.host_width = host_width;
+    texture.host_height = host_height;
+    if (!CreateTexture(texture)) {
+      return UINT32_MAX;
+    }
+    texture.rtv_format = source->rtv_format;  // only for the view format family
+    derived.source_base = source->base;
+    derived.source_version = UINT64_MAX;
+  }
+  if (derived.source_version != source->version) {
+    command_processor_.PushTransitionBarrier(source->resource, kReadState,
+                                             D3D12_RESOURCE_STATE_COPY_SOURCE);
+    command_processor_.PushTransitionBarrier(texture.resource, kReadState,
+                                             D3D12_RESOURCE_STATE_COPY_DEST);
+    command_processor_.SubmitBarriers();
+    D3D12_TEXTURE_COPY_LOCATION dst = {}, src = {};
+    dst.pResource = texture.resource;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = source->resource;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box = {src_x, src_y, 0, src_x + host_width, src_y + host_height, 1};
+    command_processor_.GetDeferredCommandList().D3DCopyTextureRegion(&dst, 0, 0, 0, &src, &box);
+    command_processor_.PushTransitionBarrier(source->resource, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                                             kReadState);
+    command_processor_.PushTransitionBarrier(texture.resource, D3D12_RESOURCE_STATE_COPY_DEST,
+                                             kReadState);
+    command_processor_.SubmitBarriers();
+    derived.source_version = source->version;
+  }
+  return GetSRV(texture, view_format, host_swizzle);
+}
+
+ID3D12Resource* NativeTextures::GetSwapTexture(uint32_t address, uint32_t width, uint32_t height,
+                                               D3D12_SHADER_RESOURCE_VIEW_DESC& srv_desc_out) {
+  auto it = textures_.find(address);
+  if (it == textures_.end() || it->second.pitch < width || it->second.height < height) {
+    return nullptr;
+  }
+  srv_desc_out = {};
+  srv_desc_out.Format = it->second.rtv_format;
+  srv_desc_out.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv_desc_out.Texture2D.MipLevels = 1;
+  srv_desc_out.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  return it->second.resource;
+}
