@@ -0,0 +1,48 @@
+/**
+ * @file        rex/system/lan_sessions.h
+ * @brief       --lan_live: a directory of Xbox Live sessions on the local
+ *              network, standing in for Live's matchmaking servers.
+ *
+ * A console hosting a public Live session (XSessionCreate as host, with
+ * presence, stats or matchmaking) announces it once a second on UDP 3076: its
+ * XSESSION_INFO, slots, and the contexts and properties its players set
+ * (XUserSetContext / XUserSetProperty, which matchmaking reads). Every
+ * console keeps the announcements it hears for a few seconds, and
+ * XSessionSearch / XSessionSearchEx / XSessionSearchByID answer from them.
+ * Search filters aren't evaluated: every open session found is a result.
+ */
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace rex::system::lan_sessions {
+
+// Starts listening for other consoles' sessions (once; --lan_live only). Done
+// early, so that a title's first search already knows them: titles search
+// right after creating their own session, and only once.
+void Start();
+
+// The signed-in player's matchmaking values (user 0's are the ones announced).
+void SetContext(uint32_t user_index, uint32_t context_id, uint32_t value);
+// `data` is the value as the title passed it (guest byte order), `size` bytes.
+void SetProperty(uint32_t user_index, uint32_t property_id, const uint8_t* data, uint32_t size);
+
+// XSessionCreate as host of a Live session: `session` is the title's session
+// object (guest address), `info` the 60-byte XSESSION_INFO just made for it.
+void HostCreated(uint32_t session, const uint8_t* info, uint32_t flags, uint32_t public_slots,
+                 uint32_t private_slots);
+void HostModified(uint32_t session, uint32_t flags, uint32_t public_slots, uint32_t private_slots);
+// Players joining or leaving a session (only the hosted one counts).
+void MembersJoined(uint32_t session, uint32_t count);
+void MembersLeft(uint32_t session, uint32_t count);
+void HostDeleted(uint32_t session);
+
+// Writes an XSESSION_SEARCHRESULT_HEADER and its results at `buffer` (host
+// pointer to the guest buffer at `guest_address`, `size` bytes): the sessions
+// heard on the LAN, at most `max_results`, only those whose XNKID is in
+// `session_ids` when it isn't null. Returns the number of results.
+uint32_t WriteSearchResults(uint8_t* buffer, uint32_t guest_address, uint32_t size,
+                            uint32_t max_results, const std::vector<uint64_t>* session_ids);
+
+}  // namespace rex::system::lan_sessions
