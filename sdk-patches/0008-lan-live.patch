+// --lan_live: the sessions heard on the LAN as search results; without it, no
+// sessions (Live's servers aren't there to ask).
+void XgiApp::WriteSearchResults(uint32_t results_ptr, uint32_t results_size, uint32_t max_results,
+                                const std::vector<uint64_t>* session_ids) {
+  if (!results_ptr || results_size < 8) {
+    return;
+  }
+  uint8_t* results = memory_->TranslateVirtual<uint8_t*>(results_ptr);
+  if (system_link::Live()) {
+    lan_sessions::WriteSearchResults(results, results_ptr, results_size, max_results,
+                                     session_ids);
+  } else {
+    std::memset(results, 0, 8);
+  }
+}
