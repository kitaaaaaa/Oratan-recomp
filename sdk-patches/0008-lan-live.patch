index 0000000..1fcf704
--- /dev/null
+++ b/src/system/lan_sessions.cpp
@@ -0,0 +1,460 @@
+/**
+ * @file        system/lan_sessions.cpp
+ * @brief       --lan_live session directory: see rex/system/lan_sessions.h.
+ *
+ * Announcement (UDP 3076, big-endian):
+ *   "OTLS", u8 version 1, u8 kind (1 announce, 2 gone), u16 0,
+ *   XSESSION_INFO (60 bytes), u32 flags, u32 public slots, u32 private slots,
+ *   u32 filled public, u32 filled private, u16 contexts, u16 properties,
+ *   contexts (u32 id, u32 value), properties (u32 id, u16 size, bytes).
+ */
+
+#include <rex/system/lan_sessions.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/system/system_link.h>
+
+#if REX_PLATFORM_WIN32
+#include <WinSock2.h>
+
+#include <WS2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+namespace rex::system::lan_sessions {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr uint16_t kPort = 3076;
+constexpr char kMagic[4] = {'O', 'T', 'L', 'S'};
+constexpr uint8_t kVersion = 1;
+constexpr uint8_t kAnnounce = 1, kGone = 2;
+constexpr auto kAnnounceEvery = std::chrono::milliseconds(1000);
+constexpr auto kForgetAfter = std::chrono::milliseconds(3500);
+
+constexpr uint32_t kInfoSize = 60;          // XSESSION_INFO
+constexpr uint32_t kResultSize = 92;        // XSESSION_SEARCHRESULT
+constexpr uint32_t kPropertySize = 24;      // XUSER_PROPERTY
+constexpr uint32_t kContextSize = 8;        // XUSER_CONTEXT
+constexpr uint32_t kMaxPropertyBytes = 256;
+
+struct Session {
+  std::array<uint8_t, kInfoSize> info{};
+  uint32_t flags = 0;
+  uint32_t public_slots = 0, private_slots = 0;
+  uint32_t filled_public = 0, filled_private = 0;
+  std::vector<std::pair<uint32_t, uint32_t>> contexts;
+  std::vector<std::pair<uint32_t, std::vector<uint8_t>>> properties;
+  uint32_t from = 0;  // the announcer's address, network byte order
+  Clock::time_point heard;
+};
+
+uint64_t KeyOf(const uint8_t* kid) {
+  uint64_t key;
+  std::memcpy(&key, kid, 8);
+  return key;
+}
+
+std::mutex g_mutex;
+// This console's own matchmaking values and hosted session.
+std::map<uint32_t, uint32_t> g_contexts;
+std::map<uint32_t, std::vector<uint8_t>> g_properties;
+uint32_t g_hosted_object = 0;  // guest session object; 0 = none
+Session g_hosted;
+Clock::time_point g_last_announce;
+// Sessions heard on the LAN, by XNKID.
+std::map<uint64_t, Session> g_heard;
+
+#if REX_PLATFORM_WIN32
+using NativeSocket = SOCKET;
+constexpr NativeSocket kNoSocket = INVALID_SOCKET;
+void CloseNative(NativeSocket s) { closesocket(s); }
+#else
+using NativeSocket = int;
+constexpr NativeSocket kNoSocket = -1;
+void CloseNative(NativeSocket s) { ::close(s); }
+#endif
+NativeSocket g_socket = kNoSocket;
+
+void Put16(std::vector<uint8_t>& out, uint16_t v) {
+  out.push_back(uint8_t(v >> 8));
+  out.push_back(uint8_t(v));
+}
+void Put32(std::vector<uint8_t>& out, uint32_t v) {
+  for (int shift = 24; shift >= 0; shift -= 8) out.push_back(uint8_t(v >> shift));
+}
+void Store32(uint8_t* p, uint32_t v) {
+  p[0] = uint8_t(v >> 24);
+  p[1] = uint8_t(v >> 16);
+  p[2] = uint8_t(v >> 8);
+  p[3] = uint8_t(v);
+}
+
+class Reader {
+ public:
+  Reader(const uint8_t* data, size_t size) : data_(data), size_(size) {}
+  bool Bytes(void* out, size_t n) {
+    if (at_ + n > size_) return false;
+    std::memcpy(out, data_ + at_, n);
+    at_ += n;
+    return true;
+  }
+  bool U8(uint8_t* v) { return Bytes(v, 1); }
+  bool U16(uint16_t* v) {
+    uint8_t b[2];
+    if (!Bytes(b, 2)) return false;
+    *v = uint16_t(b[0] << 8 | b[1]);
+    return true;
+  }
+  bool U32(uint32_t* v) {
+    uint8_t b[4];
+    if (!Bytes(b, 4)) return false;
+    *v = uint32_t(b[0]) << 24 | uint32_t(b[1]) << 16 | uint32_t(b[2]) << 8 | b[3];
+    return true;
+  }
+
+ private:
+  const uint8_t* data_;
+  size_t size_;
+  size_t at_ = 0;
+};
+
+// The hosted session as a packet; g_mutex held.
+std::vector<uint8_t> HostedPacket(uint8_t kind) {
+  std::vector<uint8_t> out(kMagic, kMagic + 4);
+  out.push_back(kVersion);
+  out.push_back(kind);
+  Put16(out, 0);
+  out.insert(out.end(), g_hosted.info.begin(), g_hosted.info.end());
+  Put32(out, g_hosted.flags);
+  Put32(out, g_hosted.public_slots);
+  Put32(out, g_hosted.private_slots);
+  Put32(out, g_hosted.filled_public);
+  Put32(out, g_hosted.filled_private);
+  Put16(out, uint16_t(g_contexts.size()));
+  Put16(out, uint16_t(g_properties.size()));
+  for (const auto& [id, value] : g_contexts) {
+    Put32(out, id);
+    Put32(out, value);
+  }
+  for (const auto& [id, bytes] : g_properties) {
+    Put32(out, id);
+    Put16(out, uint16_t(bytes.size()));
+    out.insert(out.end(), bytes.begin(), bytes.end());
+  }
+  return out;
+}
+
+void SendToLan(const std::vector<uint8_t>& packet) {
+  if (g_socket == kNoSocket) return;
+  std::vector<uint32_t> targets = system_link::BroadcastCopies();
+  if (system_link::SendRealBroadcast()) {
+    const auto broadcasts = system_link::BroadcastAddresses();
+    targets.insert(targets.end(), broadcasts.begin(), broadcasts.end());
+  }
+  for (const uint32_t address : targets) {
+    sockaddr_in to{};
+    to.sin_family = AF_INET;
+    to.sin_port = htons(kPort);
+    to.sin_addr.s_addr = address;
+    sendto(g_socket, reinterpret_cast<const char*>(packet.data()), int(packet.size()), 0,
+           reinterpret_cast<sockaddr*>(&to), sizeof(to));
+  }
+}
+
+void Receive(const uint8_t* data, size_t size, uint32_t from) {
+  Reader in(data, size);
+  char magic[4];
+  uint8_t version = 0, kind = 0;
+  uint16_t reserved = 0;
+  Session s;
+  if (!in.Bytes(magic, 4) || std::memcmp(magic, kMagic, 4) != 0 || !in.U8(&version) ||
+      version != kVersion || !in.U8(&kind) || !in.U16(&reserved) ||
+      !in.Bytes(s.info.data(), kInfoSize)) {
+    return;
+  }
+  const uint64_t key = KeyOf(s.info.data());
+  std::lock_guard lock(g_mutex);
+  if (g_hosted_object && key == KeyOf(g_hosted.info.data())) {
+    return;  // our own
+  }
+  if (kind == kGone) {
+    if (g_heard.erase(key) && system_link::Logging()) {
+      REXSYS_INFO("lan sessions: {} ended its session", system_link::Dotted(from));
+    }
+    return;
+  }
+  uint16_t contexts = 0, properties = 0;
+  if (!in.U32(&s.flags) || !in.U32(&s.public_slots) || !in.U32(&s.private_slots) ||
+      !in.U32(&s.filled_public) || !in.U32(&s.filled_private) || !in.U16(&contexts) ||
+      !in.U16(&properties)) {
+    return;
+  }
+  for (uint16_t i = 0; i < contexts; ++i) {
+    uint32_t id = 0, value = 0;
+    if (!in.U32(&id) || !in.U32(&value)) return;
+    s.contexts.emplace_back(id, value);
+  }
+  for (uint16_t i = 0; i < properties; ++i) {
+    uint32_t id = 0;
+    uint16_t length = 0;
+    if (!in.U32(&id) || !in.U16(&length) || length > kMaxPropertyBytes) return;
+    std::vector<uint8_t> bytes(length);
+    if (!in.Bytes(bytes.data(), length)) return;
+    s.properties.emplace_back(id, std::move(bytes));
+  }
+  s.from = from;
+  s.heard = Clock::now();
+  const bool is_new = g_heard.find(key) == g_heard.end();
+  g_heard[key] = std::move(s);
+  if (is_new && system_link::Logging()) {
+    const Session& heard = g_heard[key];
+    REXSYS_INFO("lan sessions: heard a session from {} ({}/{} public, {}/{} private, "
+                "{} context(s), {} propert(ies))",
+                system_link::Dotted(from), heard.filled_public, heard.public_slots,
+                heard.filled_private, heard.private_slots, heard.contexts.size(),
+                heard.properties.size());
+  }
+}
+
+void Run() {
+  for (;;) {
+    {
+      std::lock_guard lock(g_mutex);
+      const auto now = Clock::now();
+      if (g_hosted_object && now - g_last_announce >= kAnnounceEvery) {
+        SendToLan(HostedPacket(kAnnounce));
+        g_last_announce = now;
+      }
+      for (auto it = g_heard.begin(); it != g_heard.end();) {
+        it = now - it->second.heard > kForgetAfter ? g_heard.erase(it) : std::next(it);
+      }
+    }
+    fd_set read_set;
+    FD_ZERO(&read_set);
+    FD_SET(g_socket, &read_set);
+    timeval timeout{0, 100 * 1000};
+    if (select(int(g_socket) + 1, &read_set, nullptr, nullptr, &timeout) <= 0) {
+      continue;
+    }
+    uint8_t packet[1500];
+    sockaddr_in from{};
+    socklen_t from_len = sizeof(from);
+    const int got = int(recvfrom(g_socket, reinterpret_cast<char*>(packet), sizeof(packet), 0,
+                                 reinterpret_cast<sockaddr*>(&from), &from_len));
+    if (got > 0) {
+      Receive(packet, size_t(got), from.sin_addr.s_addr);
+    }
+  }
+}
+
+}  // namespace
+
+void Start() {
+  if (!system_link::Live()) return;
+  static std::once_flag once;
+  std::call_once(once, [] {
+#if REX_PLATFORM_WIN32
+    WSADATA wsa;
+    WSAStartup(MAKEWORD(2, 2), &wsa);
+#endif
+    g_socket = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (g_socket == kNoSocket) {
+      REXSYS_WARN("lan sessions: cannot open a socket");
+      return;
+    }
+    int on = 1;
+    setsockopt(g_socket, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<char*>(&on), sizeof(on));
+#if REX_PLATFORM_WIN32
+    // No WSAECONNRESET after a datagram to a closed port (see XSocket).
+    constexpr DWORD kSioUdpConnReset = _WSAIOW(IOC_VENDOR, 12);
+    BOOL report = FALSE;
+    DWORD unused = 0;
+    WSAIoctl(g_socket, kSioUdpConnReset, &report, sizeof(report), nullptr, 0, &unused, nullptr,
+             nullptr);
+#endif
+    sockaddr_in at{};
+    at.sin_family = AF_INET;
+    at.sin_port = htons(kPort);
+    at.sin_addr.s_addr = system_link::BindAddress();
+    if (bind(g_socket, reinterpret_cast<sockaddr*>(&at), sizeof(at)) != 0) {
+      REXSYS_WARN("lan sessions: cannot bind UDP {} on {}; other consoles' sessions won't be "
+                  "found",
+                  kPort, system_link::Dotted(at.sin_addr.s_addr));
+    } else {
+      REXSYS_INFO("lan sessions: listening on {}:{}", system_link::Dotted(at.sin_addr.s_addr),
+                  kPort);
+    }
+    std::thread(Run).detach();
+  });
+}
+
+void SetContext(uint32_t user_index, uint32_t context_id, uint32_t value) {
+  if (!system_link::Live() || user_index != 0) return;
+  std::lock_guard lock(g_mutex);
+  g_contexts[context_id] = value;
+}
+
+void SetProperty(uint32_t user_index, uint32_t property_id, const uint8_t* data, uint32_t size) {
+  if (!system_link::Live() || user_index != 0 || !data || size > kMaxPropertyBytes) return;
+  std::lock_guard lock(g_mutex);
+  g_properties[property_id] = std::vector<uint8_t>(data, data + size);
+}
+
+void HostCreated(uint32_t session, const uint8_t* info, uint32_t flags, uint32_t public_slots,
+                 uint32_t private_slots) {
+  if (!system_link::Live() || !info) return;
+  Start();
+  std::lock_guard lock(g_mutex);
+  g_hosted_object = session;
+  g_hosted = Session{};
+  std::memcpy(g_hosted.info.data(), info, kInfoSize);
+  g_hosted.flags = flags;
+  g_hosted.public_slots = public_slots;
+  g_hosted.private_slots = private_slots;
+  // Private sessions (no public slot) aren't for strangers to find.
+  if (public_slots == 0) {
+    g_hosted_object = 0;
+    return;
+  }
+  SendToLan(HostedPacket(kAnnounce));
+  g_last_announce = Clock::now();
+  if (system_link::Logging()) {
+    REXSYS_INFO("lan sessions: announcing this console's session ({} public slot(s))",
+                public_slots);
+  }
+}
+
+void HostModified(uint32_t session, uint32_t flags, uint32_t public_slots,
+                  uint32_t private_slots) {
+  std::lock_guard lock(g_mutex);
+  if (!g_hosted_object || session != g_hosted_object) return;
+  g_hosted.flags = flags;
+  g_hosted.public_slots = public_slots;
+  g_hosted.private_slots = private_slots;
+}
+
+void MembersJoined(uint32_t session, uint32_t count) {
+  std::lock_guard lock(g_mutex);
+  if (!g_hosted_object || session != g_hosted_object) return;
+  g_hosted.filled_public = std::min(g_hosted.public_slots, g_hosted.filled_public + count);
+}
+
+void MembersLeft(uint32_t session, uint32_t count) {
+  std::lock_guard lock(g_mutex);
+  if (!g_hosted_object || session != g_hosted_object) return;
+  g_hosted.filled_public = g_hosted.filled_public > count ? g_hosted.filled_public - count : 0;
+}
+
+void HostDeleted(uint32_t session) {
+  std::lock_guard lock(g_mutex);
+  if (!g_hosted_object || session != g_hosted_object) return;
+  SendToLan(HostedPacket(kGone));
+  g_hosted_object = 0;
+  if (system_link::Logging()) {
+    REXSYS_INFO("lan sessions: this console's session ended");
+  }
+}
+
+uint32_t WriteSearchResults(uint8_t* buffer, uint32_t guest_address, uint32_t size,
+                            uint32_t max_results, const std::vector<uint64_t>* session_ids) {
+  if (!buffer || size < 8) return 0;
+  Start();
+  std::vector<Session> found;
+  {
+    std::lock_guard lock(g_mutex);
+    for (const auto& [key, session] : g_heard) {
+      if (session_ids &&
+          std::find(session_ids->begin(), session_ids->end(), key) == session_ids->end()) {
+        continue;
+      }
+      found.push_back(session);
+    }
+  }
+  // Fullest first (a lobby waiting for players), as matchmaking would.
+  std::stable_sort(found.begin(), found.end(), [](const Session& a, const Session& b) {
+    return a.filled_public > b.filled_public;
+  });
+
+  // Header, results, then each result's properties, contexts and data.
+  std::memset(buffer, 0, size);
+  const size_t heard = found.size();
+  uint32_t count = 0;
+  uint32_t needed = 8;  // header, results and everything they point to so far
+  for (const Session& s : found) {
+    if (count == max_results) break;
+    uint32_t extra = kResultSize + uint32_t(s.properties.size()) * kPropertySize +
+                     uint32_t(s.contexts.size()) * kContextSize;
+    for (const auto& [id, bytes] : s.properties) extra += (uint32_t(bytes.size()) + 3) & ~3u;
+    if (needed + extra > size) break;
+    needed += extra;
+    ++count;
+  }
+  found.resize(count);
+  // Results first (the array is contiguous), the rest after them.
+  uint32_t tail = 8 + count * kResultSize;
+  for (uint32_t i = 0; i < count; ++i) {
+    const Session& s = found[i];
+    uint8_t* r = buffer + 8 + i * kResultSize;
+    std::memcpy(r, s.info.data(), kInfoSize);
+    Store32(r + 60, s.public_slots - std::min(s.public_slots, s.filled_public));
+    Store32(r + 64, s.private_slots - std::min(s.private_slots, s.filled_private));
+    Store32(r + 68, s.filled_public);
+    Store32(r + 72, s.filled_private);
+    Store32(r + 76, uint32_t(s.properties.size()));
+    Store32(r + 80, uint32_t(s.contexts.size()));
+    const uint32_t properties_at = tail;
+    tail += uint32_t(s.properties.size()) * kPropertySize;
+    const uint32_t contexts_at = tail;
+    tail += uint32_t(s.contexts.size()) * kContextSize;
+    Store32(r + 84, s.properties.empty() ? 0 : guest_address + properties_at);
+    Store32(r + 88, s.contexts.empty() ? 0 : guest_address + contexts_at);
+    // XUSER_PROPERTY: u32 id, 4 bytes padding, XUSER_DATA (u8 type, 7 padding,
+    // 8-byte union). The type is in the id's top four bits.
+    for (size_t p = 0; p < s.properties.size(); ++p) {
+      const auto& [id, bytes] = s.properties[p];
+      uint8_t* prop = buffer + properties_at + p * kPropertySize;
+      const uint8_t type = uint8_t(id >> 28);
+      Store32(prop, id);
+      prop[8] = type;
+      if (type == 4 || type == 6) {  // unicode string, binary: size and pointer
+        std::memcpy(buffer + tail, bytes.data(), bytes.size());
+        Store32(prop + 16, uint32_t(bytes.size()));
+        Store32(prop + 20, guest_address + tail);
+        tail += (uint32_t(bytes.size()) + 3) & ~3u;
+      } else {
+        std::memcpy(prop + 16, bytes.data(), std::min<size_t>(bytes.size(), 8));
+      }
+    }
+    for (size_t c = 0; c < s.contexts.size(); ++c) {
+      uint8_t* context = buffer + contexts_at + c * kContextSize;
+      Store32(context, s.contexts[c].first);
+      Store32(context + 4, s.contexts[c].second);
+    }
+  }
+  Store32(buffer, count);
+  Store32(buffer + 4, count ? guest_address + 8 : 0);
+  if (system_link::Logging()) {
+    REXSYS_INFO("lan sessions: search -> {} of {} session(s) heard", count, heard);
+  }
+  return count;
+}
+
+}  // namespace rex::system::lan_sessions
