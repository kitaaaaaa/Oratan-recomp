+void NativeTextures::ApplyShadows(Texture& scene_color) {
+  if (!REXCVAR_GET(native_shadows)) {
+    return;
+  }
+  auto scene_depth = textures_.find(scene_depth_base_);
+  if (scene_depth == textures_.end() ||
+      scene_depth->second.host_width != scene_color.host_width ||
+      scene_depth->second.host_height != scene_color.host_height) {
+    return;
+  }
+  Texture* light_maps[kMaxLightPasses] = {};
+  uint32_t pass_mask = 0;
+  for (uint32_t i = 0; i < std::min(light_pass_count_, kMaxLightPasses); ++i) {
+    auto light = textures_.find(light_depth_bases_[i]);
+    if (light_transform_valid_[i] && light != textures_.end()) {
+      light_maps[i] = &light->second;
+      pass_mask |= 1u << i;
+    }
+  }
+  if (!pass_mask) {
+    return;
+  }
+  // Both light maps are bound; an unused slot gets a valid one.
+  for (uint32_t i = 0; i < kMaxLightPasses; ++i) {
+    if (!light_maps[i]) light_maps[i] = light_maps[(pass_mask & 1) ? 0 : 1];
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  if (!shadow_pipeline_ || shadow_pipeline_format_ != scene_color.rtv_format) {
+    ui::d3d12::util::ReleaseAndNull(shadow_pipeline_);
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC desc = {};
+    desc.pRootSignature = shadow_root_signature_;
+    desc.VS.pShaderBytecode = vs_.data();
+    desc.VS.BytecodeLength = vs_.size();
+    desc.PS.pShaderBytecode = ps_shadow_.data();
+    desc.PS.BytecodeLength = ps_shadow_.size();
+    auto& blend = desc.BlendState.RenderTarget[0];
+    if (REXCVAR_GET(native_shadow_debug)) {
+      blend.BlendEnable = FALSE;
+    } else {
+      // dest * src: the pass outputs the shadow factor.
+      blend.BlendEnable = TRUE;
+      blend.SrcBlend = D3D12_BLEND_ZERO;
+      blend.DestBlend = D3D12_BLEND_SRC_COLOR;
+      blend.BlendOp = D3D12_BLEND_OP_ADD;
+      blend.SrcBlendAlpha = D3D12_BLEND_ZERO;
+      blend.DestBlendAlpha = D3D12_BLEND_ONE;
+      blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    }
+    blend.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    desc.SampleMask = UINT_MAX;
+    desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    desc.RasterizerState.DepthClipEnable = TRUE;
+    desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    desc.NumRenderTargets = 1;
+    desc.RTVFormats[0] = scene_color.rtv_format;
+    desc.SampleDesc.Count = 1;
+    if (FAILED(device->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(&shadow_pipeline_)))) {
+      REXGPU_ERROR("NativeTextures: failed to create the shadow pipeline");
+      shadow_pipeline_ = nullptr;
+      return;
+    }
+    shadow_pipeline_format_ = scene_color.rtv_format;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[3];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(3, descriptors)) {
+    return;
+  }
+  Texture* inputs[3] = {&scene_depth->second, light_maps[0], light_maps[1]};
+  for (uint32_t i = 0; i < 3; ++i) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv = {};
+    srv.Format = inputs[i]->rtv_format;
+    srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    srv.Texture2D.MipLevels = 1;
+    srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    device->CreateShaderResourceView(inputs[i]->resource, &srv, descriptors[i].first);
+  }
+  float constants[52] = {};
+  for (uint32_t i = 0; i < kMaxLightPasses; ++i) {
+    std::memcpy(constants + i * 16, light_transforms_[i], sizeof(light_transforms_[i]));
+  }
+  constants[32] = float(REXCVAR_GET(native_shadow_strength));
+  constants[33] = 0.0015f;  // depth bias (light clip space)
+  constants[34] = float(REXCVAR_GET(native_shadow_debug));
+  constants[35] = float(pass_mask);
+  constants[36] = float(scene_color.host_width);
+  constants[37] = float(scene_color.host_height);
+  constants[38] = 1.0f / float(scene_color.host_width);
+  constants[39] = 1.0f / float(scene_color.host_height);
+  constants[40] = float(light_maps[0]->host_width);
+  constants[41] = float(light_maps[0]->host_height);
+  constants[42] = 1.0f / float(light_maps[0]->host_width);
+  constants[43] = 1.0f / float(light_maps[0]->host_height);
+  std::memcpy(constants + 44, camera_projection_, sizeof(camera_projection_));
+  constants[48] = float(REXCVAR_GET(native_ao_strength));
+  constants[49] = float(REXCVAR_GET(native_ao_radius));
+  constants[50] = (camera_projection_valid_ && REXCVAR_GET(native_ao_strength) > 0.0) ? 1.0f : 0.0f;
+  constants[51] = REXCVAR_GET(native_self_shadow) ? 1.0f : 0.0f;
+  D3D12_VIEWPORT viewport = {0.0f, 0.0f, float(scene_color.host_width),
+                             float(scene_color.host_height), 0.0f, 1.0f};
+  D3D12_RECT scissor = {0, 0, LONG(scene_color.host_width), LONG(scene_color.host_height)};
+  command_processor_.PushTransitionBarrier(scene_color.resource, kReadState,
+                                           D3D12_RESOURCE_STATE_RENDER_TARGET);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_heap_->GetCPUDescriptorHandleForHeapStart();
+  rtv.ptr += size_t(scene_color.rtv_index) * rtv_descriptor_size_;
+  command_list.D3DOMSetRenderTargets(1, &rtv, FALSE, nullptr);
+  command_processor_.SetExternalGraphicsRootSignature(shadow_root_signature_);
+  command_processor_.SetExternalPipeline(shadow_pipeline_);
+  command_list.D3DSetGraphicsRoot32BitConstants(0, 52, constants, 0);
+  command_list.D3DSetGraphicsRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetGraphicsRootDescriptorTable(2, descriptors[1].second);
+  command_list.D3DSetGraphicsRootDescriptorTable(3, descriptors[2].second);
+  command_processor_.SetViewport(viewport);
+  command_processor_.SetScissorRect(scissor);
+  command_processor_.SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  command_list.D3DDrawInstanced(3, 1, 0, 0);
+  command_processor_.PushTransitionBarrier(scene_color.resource,
+                                           D3D12_RESOURCE_STATE_RENDER_TARGET, kReadState);
+  ++scene_color.version;
+}
