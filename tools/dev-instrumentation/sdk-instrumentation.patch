+void D3D12RenderTargetCache::NativeClearAliases(const memory::Memory& memory,
+                                                const Shader& vertex_shader,
+                                                const Shader* pixel_shader,
+                                                xenos::PrimitiveType primitive_type) {
+  // The Direct3D 9 clear shaders: position and colour from vertex fetch 95.
+  constexpr uint64_t kClearVertexShader = 0x1E6883FCCDE1F688ull;
+  constexpr uint64_t kClearPixelShader = 0xA4A965C189287B99ull;
+  if (!native_render_targets_ || !pixel_shader ||
+      vertex_shader.ucode_data_hash() != kClearVertexShader ||
+      pixel_shader->ucode_data_hash() != kClearPixelShader ||
+      primitive_type != xenos::PrimitiveType::kRectangleList) {
+    return;
+  }
+  const RegisterFile& regs = register_file();
+  xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(95);
+  if (fetch.type != xenos::FetchConstantType::kVertex || fetch.size < 3 * 7) {
+    return;
+  }
+  const uint32_t* vertices =
+      reinterpret_cast<const uint32_t*>(memory.TranslatePhysical(fetch.address * sizeof(uint32_t)));
+  if (!vertices) {
+    return;
+  }
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  auto vertex_float = [&](uint32_t index) {
+    float value;
+    uint32_t bits = xenos::GpuSwap(vertices[index_offset * 7 + index], fetch.endian);
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+  };
+  auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float x_scale = vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  float x_offset = vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  float y_scale = vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  float y_offset = vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+  float x0 = FLT_MAX, y0 = FLT_MAX, x1 = -FLT_MAX, y1 = -FLT_MAX;
+  for (uint32_t i = 0; i < 3; ++i) {
+    float x = vertex_float(i * 7 + 0) * x_scale + x_offset;
+    float y = vertex_float(i * 7 + 1) * y_scale + y_offset;
+    x0 = std::min(x0, x);
+    x1 = std::max(x1, x);
+    y0 = std::min(y0, y);
+    y1 = std::max(y1, y);
+  }
+  // The rectangle list's implied fourth corner doesn't change the bounds.
+  float depth = vertex_float(2);
+  float color[4] = {vertex_float(3), vertex_float(4), vertex_float(5), vertex_float(6)};
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+    x0 += float(window_offset.window_x_offset);
+    x1 += float(window_offset.window_x_offset);
+    y0 += float(window_offset.window_y_offset);
+    y1 += float(window_offset.window_y_offset);
+  }
+  // The vertex positions aren't plain pixels (VTE 0x300); Direct3D 9 sets the
+  // scissor to the cleared area, so use that.
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  x0 = float(scissor.offset[0]);
+  y0 = float(scissor.offset[1]);
+  x1 = float(scissor.offset[0] + scissor.extent[0]);
+  y1 = float(scissor.offset[1] + scissor.extent[1]);
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  auto stencil_ref_mask = regs.Get<reg::RB_STENCILREFMASK>();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  static uint32_t log_count = 0;
+  RenderTarget* const* bound_for_log = last_update_accumulated_render_targets();
+  bool shadow_sized = false;
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (bound_for_log[i] && bound_for_log[i]->key().pitch_tiles_at_32bpp == 13) shadow_sized = true;
+  }
+  bool log = shadow_sized && log_count < 200;
+  if (log) {
+    ++log_count;
+    std::string raw;
+    for (uint32_t i = 0; i < 21; ++i) {
+      raw += fmt::format(" {}", vertex_float(i));
+    }
+    REXGPU_INFO("NativeClear: fetch {:08X} size {} index offset {} raw{}", fetch.address * 4,
+                uint32_t(fetch.size), index_offset, raw);
+    REXGPU_INFO("NativeClear: rect {},{} - {},{} z {} colour {} {} {} {} vte {:X}", x0, y0, x1, y1,
+                depth, color[0], color[1], color[2], color[3], vte.value);
+  }
+
+  RenderTarget* const* bound = last_update_accumulated_render_targets();
+  for (uint32_t slot = 0; slot < 2; ++slot) {
+    // Depth (0) and colour 0 (1).
+    const RenderTarget* source = bound[slot];
+    if (!source) {
+      continue;
+    }
+    RenderTargetKey source_key = source->key();
+    float source_scale_x, source_scale_y;
+    GetNativeScale(source_key, source_scale_x, source_scale_y);
+    // The rectangle in EDRAM samples.
+    uint32_t source_samples_x = source_key.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1;
+    uint32_t source_samples_y = source_key.msaa_samples >= xenos::MsaaSamples::k2X ? 2 : 1;
+    float sx0 = x0 * source_samples_x, sx1 = x1 * source_samples_x;
+    float sy0 = y0 * source_samples_y, sy1 = y1 * source_samples_y;
+    ForEachRenderTarget([&](RenderTarget* target) {
+      RenderTargetKey key = target->key();
+      if (target == source || key.base_tiles != source_key.base_tiles ||
+          key.pitch_tiles_at_32bpp != source_key.pitch_tiles_at_32bpp ||
+          key.is_depth != source_key.is_depth ||
+          (!key.is_depth && xenos::IsColorRenderTargetFormat64bpp(key.GetColorFormat()) !=
+                                xenos::IsColorRenderTargetFormat64bpp(
+                                    source_key.GetColorFormat()))) {
+        return;
+      }
+      float scale_x, scale_y;
+      GetNativeScale(key, scale_x, scale_y);
+      if (scale_x == source_scale_x && scale_y == source_scale_y) {
+        return;  // EDRAM transfers handle same-scale aliases.
+      }
+      uint32_t samples_x = key.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1;
+      uint32_t samples_y = key.msaa_samples >= xenos::MsaaSamples::k2X ? 2 : 1;
+      D3D12_RECT rect;
+      rect.left = LONG(std::floor(sx0 / samples_x * scale_x));
+      rect.top = LONG(std::floor(sy0 / samples_y * scale_y));
+      rect.right = LONG(std::ceil(sx1 / samples_x * scale_x));
+      rect.bottom = LONG(std::ceil(sy1 / samples_y * scale_y));
+      auto& clamp_target = *static_cast<D3D12RenderTarget*>(target);
+      D3D12_RESOURCE_DESC target_desc = clamp_target.resource()->GetDesc();
+      rect.left = std::clamp(rect.left, LONG(0), LONG(target_desc.Width));
+      rect.right = std::clamp(rect.right, LONG(0), LONG(target_desc.Width));
+      rect.top = std::clamp(rect.top, LONG(0), LONG(target_desc.Height));
+      rect.bottom = std::clamp(rect.bottom, LONG(0), LONG(target_desc.Height));
+      if (rect.right <= rect.left || rect.bottom <= rect.top) {
+        return;
+      }
+      if (log) {
+        REXGPU_INFO("NativeClear:   {} -> {} host rect {},{} - {},{}", source_key.GetDebugName(),
+                    key.GetDebugName(), rect.left, rect.top, rect.right, rect.bottom);
+      }
+      auto& d3d12_target = *static_cast<D3D12RenderTarget*>(target);
+      if (key.is_depth) {
+        command_processor_.PushTransitionBarrier(
+            d3d12_target.resource(),
+            d3d12_target.SetResourceState(D3D12_RESOURCE_STATE_DEPTH_WRITE),
+            D3D12_RESOURCE_STATE_DEPTH_WRITE);
+        command_processor_.SubmitBarriers();
+        float host_depth = key.GetDepthFormat() == xenos::DepthRenderTargetFormat::kD24FS8
+                               ? depth * 0.5f
+                               : depth;
+        command_list.D3DClearDepthStencilView(
+            d3d12_target.descriptor_draw().GetHandle(),
+            D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL, std::clamp(host_depth, 0.0f, 1.0f),
+            UINT8(stencil_ref_mask.stencilref), 1, &rect);
+      } else {
+        command_processor_.PushTransitionBarrier(
+            d3d12_target.resource(),
+            d3d12_target.SetResourceState(D3D12_RESOURCE_STATE_RENDER_TARGET),
+            D3D12_RESOURCE_STATE_RENDER_TARGET);
+        command_processor_.SubmitBarriers();
+        command_list.D3DClearRenderTargetView(d3d12_target.descriptor_draw().GetHandle(), color, 1,
+                                              &rect);
+      }
+    });
+  }
+}
